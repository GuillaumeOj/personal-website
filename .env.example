# Build-time vars (read by @astro-notion/loader during `astro build`)

# Notion integration token (https://www.notion.so/profile/integrations)
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Notion database ID (32 chars, from the database URL)
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Vercel Blob token used to persist Notion-hosted images (covers + body) so the
# site keeps working past the ~1h expiry of Notion's signed AWS URLs.
# Auto-injected by Vercel in production; pull locally with `vercel env pull .env`.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Runtime vars (set on Vercel; consumed by api/notion-webhook.ts at request time,
# not needed for local `bun build`)

# Notion webhook subscription verification token; doubles as the HMAC-SHA256 key
# for signed event payloads. Capture it from Vercel function logs on the first
# verification POST, then store it here.
NOTION_WEBHOOK_SECRET=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Vercel Deploy Hook URL that the webhook handler POSTs to in order to trigger
# a rebuild after a published Notion page changes.
VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/prj_xxx/xxx

# Brevo API key, consumed by api/contact.ts to send the contact-form submission
# as a transactional email (https://app.brevo.com/settings/keys/api). The sender
# address in src/lib/contact.ts must be a verified sender/domain in Brevo.
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
