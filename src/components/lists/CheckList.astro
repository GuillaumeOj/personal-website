---
import type { Locale, Localized } from '../../config';
import Icon from '../Icon.astro';

// A list with an accent check mark before each item.
interface Props {
  locale: Locale;
  items: Localized[];
  class?: string;
}

const { locale, items, class: className } = Astro.props;
---

<ul class:list={['list-none space-y-3 p-0 text-ink', className]}>
  {
    items.map((item) => (
      <li class="flex items-start gap-3">
        <Icon name="check" size={16} class="mt-1 shrink-0 text-accent" />
        <span>{item[locale]}</span>
      </li>
    ))
  }
</ul>
