---
import AboutMe from '../../components/home/AboutMe.astro';
import Contact from '../../components/home/Contact.astro';
import FeaturedProjects from '../../components/home/FeaturedProjects.astro';
import Hero from '../../components/home/Hero.astro';
import HowIWork from '../../components/home/HowIWork.astro';
import WhatIDo from '../../components/home/WhatIDo.astro';
import { SITE } from '../../config';
import BaseLayout from '../../layouts/BaseLayout.astro';

const locale = 'en' as const;
---

<BaseLayout
  locale={locale}
  title={SITE.name}
  description="Guillaume Ojardias, freelance fullstack developer — web and mobile applications, from frontend to backend through deployment. Python/Django, React Native, Next.js, PostgreSQL."
  container="full"
  snap
>
  <Hero locale={locale} />
  <WhatIDo locale={locale} />
  <HowIWork locale={locale} />
  <FeaturedProjects locale={locale} />
  <Contact locale={locale} />
  <AboutMe locale={locale} />
</BaseLayout>
