---
import { getCollection } from 'astro:content';
import ArticleCard from '../components/ArticleCard.astro';
import type { Locale } from '../config';
import { t } from '../i18n/ui';
import BaseLayout from '../layouts/BaseLayout.astro';

const all = await getCollection('blog');
const latest = (lang: Locale) =>
  all
    .filter((post) => post.data.lang === lang && !post.data.draft)
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .slice(0, 3);

const posts: Record<Locale, ReturnType<typeof latest>> = {
  fr: latest('fr'),
  en: latest('en'),
};

const locales: Locale[] = ['fr', 'en'];
---

<BaseLayout
  locale="fr"
  title={t('fr', 'error.404.title')}
  description={t('fr', 'error.404.message')}
>
  {
    locales.map((locale) => (
      <section
        data-locale={locale}
        class:list={[
          'locale-block space-y-10',
          locale === 'en' && 'hidden',
        ]}
      >
        <header class="space-y-4 text-center">
          <p
            class="font-mono text-7xl font-bold tracking-tight text-zinc-900 sm:text-8xl dark:text-zinc-100"
            style="display:inline-block;animation:var(--animate-wobble);transform-origin:center;"
          >
            {t(locale, 'error.404.title')}
          </p>
          <p class="text-2xl font-semibold tracking-tight text-zinc-900 dark:text-zinc-100">
            {t(locale, 'error.404.lead')}
          </p>
          <p class="mx-auto max-w-xl text-zinc-600 dark:text-zinc-400">
            {t(locale, 'error.404.message')}
          </p>
          <p>
            <a
              href={locale === 'en' ? '/en/' : '/'}
              class="text-sm text-zinc-600 dark:text-zinc-400"
            >
              {t(locale, 'error.backHome')}
            </a>
          </p>
        </header>

        {posts[locale].length > 0 && (
          <div class="space-y-4">
            <h2 class="text-lg font-semibold tracking-tight text-zinc-900 dark:text-zinc-100">
              {t(locale, 'error.recentArticles')}
            </h2>
            <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
              {posts[locale].map((post) => (
                <ArticleCard post={post} locale={locale} />
              ))}
            </div>
          </div>
        )}
      </section>
    ))
  }
</BaseLayout>

<script is:inline>
  (() => {
    const isEn = location.pathname.startsWith('/en/');
    const target = isEn ? 'en' : 'fr';
    document.documentElement.lang = target;
    document.querySelectorAll('.locale-block').forEach((el) => {
      el.classList.toggle(
        'hidden',
        el.getAttribute('data-locale') !== target,
      );
    });
  })();
</script>
