---
import Breadcrumb from '../../components/Breadcrumb.astro';
import PostList from '../../components/PostList.astro';
import { SITE } from '../../config';
import { ensureTrailingSlash, localizedPath, t } from '../../i18n/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPostsForLocale } from '../../lib/posts';
import { collectionPageJsonLd } from '../../lib/schema';

const locale = 'fr' as const;
const posts = await getPostsForLocale(locale);

const canonical = new URL(
  ensureTrailingSlash(localizedPath(locale, '/blog')),
  SITE.url,
).toString();
const jsonLd = collectionPageJsonLd(locale, {
  url: canonical,
  name: t(locale, 'meta.blogTitle'),
  description: t(locale, 'meta.blogDescription'),
  breadcrumbs: [
    { name: t(locale, 'nav.home'), url: new URL(ensureTrailingSlash(localizedPath(locale, '/')), SITE.url).toString() },
    { name: t(locale, 'nav.blog'), url: canonical },
  ],
});

// Visible trail (Home › Blog) mirroring the BreadcrumbList JSON-LD.
const crumbs = [
  {
    name: t(locale, 'nav.home'),
    href: new URL(ensureTrailingSlash(localizedPath(locale, '/')), SITE.url).toString(),
  },
  { name: t(locale, 'nav.blog'), href: canonical },
];
---

<BaseLayout
  locale={locale}
  title={t(locale, 'meta.blogTitle')}
  description={t(locale, 'meta.blogDescription')}
  jsonLd={jsonLd}
  container="full"
  hreflang
>
  <div class="mx-auto max-w-6xl px-6 py-12 sm:py-16">
    <Breadcrumb items={crumbs} class="mb-8" />
    <section class="max-w-2xl space-y-3">
      <h1 class="page-title">{t(locale, 'blog.title')}</h1>
      <p class="text-lg text-muted">
        {t(locale, 'blog.subtitle')}
      </p>
    </section>

    <div class="mt-10">
      <PostList posts={posts} locale={locale} />
    </div>
  </div>
</BaseLayout>
