---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../config';
import { articlePath, formatDate } from '../i18n/ui';

interface Props {
  post: CollectionEntry<'blog'>;
  locale: Locale;
  priority?: boolean;
}

const { post, locale, priority = false } = Astro.props;
const href = articlePath(locale, post.data.translationKey, post.data.slug);
const { author } = post.data;
---

<a
  href={href}
  class="group flex flex-col overflow-hidden rounded-2xl border border-line bg-surface no-underline transition-[transform,box-shadow,border-color] duration-300 ease-out hover:-translate-y-1 hover:shadow-xl hover:shadow-black/5"
>
  {
    post.data.cover ? (
      <div class="aspect-[16/9] w-full overflow-hidden">
        <Image
          src={post.data.cover}
          inferSize
          alt=""
          loading={priority ? 'eager' : 'lazy'}
          fetchpriority={priority ? 'high' : 'auto'}
          class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
        />
      </div>
    ) : (
      <div class="aspect-[16/9] w-full bg-surface-sunken" />
    )
  }
  <div class="flex flex-1 flex-col gap-2 p-5">
    <h3 class="font-display text-lg font-semibold tracking-tight text-ink-strong">
      {post.data.title}
    </h3>
    <p class="line-clamp-3 text-sm leading-relaxed text-muted">
      {post.data.description}
    </p>
    <div class="mt-auto flex flex-wrap items-center gap-x-3 gap-y-1 pt-3 text-xs text-muted">
      <time datetime={post.data.pubDate.toISOString()}>
        {formatDate(post.data.pubDate, locale)}
      </time>
      {
        author && (
          <span class="inline-flex items-center gap-1.5">
            {author.avatarUrl && (
              <img
                src={author.avatarUrl}
                alt=""
                loading="lazy"
                class="h-5 w-5 rounded-full object-cover"
              />
            )}
            <span>{author.name}</span>
          </span>
        )
      }
    </div>
  </div>
</a>
