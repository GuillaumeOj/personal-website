---

<ul
  class="flex flex-wrap gap-x-6 gap-y-3 text-muted list-none p-0"
>
  {
    socials.map(({ key, icon }) => (
      <li>
        <a
          href={SITE.social[key]}
          rel="me noopener"
          class="inline-flex items-center gap-2 no-underline transition-colors hover:text-accent-ink"
        >
          <svg
            viewBox="0 0 24 24"
            fill="currentColor"
            class="h-5 w-5 shrink-0"
            aria-hidden="true"
          >
            <path d={icon} />
          </svg>
          <span>{t(locale, `home.contact.${key}`)}</span>
        </a>
      </li>
    ))
  }
</ul>
