---
import { SITE, type Locale } from '../config';
import { localizedPath, t } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const year = new Date().getFullYear();
const rssHref = localizedPath(locale, '/rss.xml');
---

<footer class="border-t border-zinc-200 dark:border-zinc-800">
  <div
    class="mx-auto flex max-w-3xl flex-col gap-3 px-6 py-8 text-sm text-zinc-500 sm:flex-row sm:items-center sm:justify-between"
  >
    <p>© {year} {SITE.name}</p>
    <p>
      <a
        href={rssHref}
        type="application/rss+xml"
        class="hover:text-zinc-900 dark:hover:text-zinc-100"
      >
        {t(locale, 'footer.rss')}
      </a>
    </p>
    <p>{t(locale, 'footer.builtWith')}</p>
  </div>
</footer>
