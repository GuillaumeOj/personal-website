---
/**
 * A disclosure dropdown: a trigger button that shows or hides a panel of
 * links or buttons (WAI-ARIA disclosure pattern, not `role="menu"`, so Tab
 * moves through the items and screen readers don't expect arrow keys). Fill
 * the `trigger` slot with the button content and the default slot with
 * `<li>` rows (see `.menu-item`). Every dropdown on the page is wired once by
 * the co-located script below.
 */
interface Props {
  /** Accessible label + tooltip for the trigger button. */
  label: string;
  /** Unique on the page: each switcher renders twice (desktop + mobile). */
  id: string;
}

const { label, id } = Astro.props;
const panelId = `dropdown-${id}`;

const triggerClass =
  'inline-flex h-9 items-center gap-1.5 rounded-md border border-line px-2.5 text-sm font-medium text-muted transition-colors hover:bg-surface-sunken hover:text-ink-strong';
const panelClass =
  'absolute left-0 top-full z-30 mt-2 hidden min-w-[9rem] rounded-lg border border-line bg-surface p-1 shadow-lg shadow-black/5';
---

<div class="relative" data-dropdown>
  <button
    type="button"
    data-dropdown-trigger
    aria-expanded="false"
    aria-controls={panelId}
    aria-label={label}
    title={label}
    class={triggerClass}
  >
    <slot name="trigger" />
  </button>
  <ul id={panelId} data-dropdown-menu class={panelClass}>
    <slot />
  </ul>
</div>

<script>
  // Open/close for every [data-dropdown] on the page. Astro emits this script
  // once no matter how many Dropdowns render, so it wires them all up together.
  type Parts = { root: HTMLElement; trigger: HTMLElement; menu: HTMLElement };
  const dropdowns: Parts[] = [];
  for (const root of document.querySelectorAll<HTMLElement>('[data-dropdown]')) {
    const trigger = root.querySelector<HTMLElement>('[data-dropdown-trigger]');
    const menu = root.querySelector<HTMLElement>('[data-dropdown-menu]');
    if (trigger && menu) dropdowns.push({ root, trigger, menu });
  }

  const close = ({ trigger, menu }: Parts): void => {
    menu.classList.add('hidden');
    trigger.setAttribute('aria-expanded', 'false');
  };

  const closeAll = (except?: Parts): void => {
    for (const dropdown of dropdowns) if (dropdown !== except) close(dropdown);
  };

  for (const dropdown of dropdowns) {
    const { root, trigger, menu } = dropdown;

    trigger.addEventListener('click', (event) => {
      event.stopPropagation();
      const willOpen = menu.classList.contains('hidden');
      closeAll(dropdown);
      if (willOpen) {
        // Reset to the default placement (below, left-aligned), then flip on
        // either edge if the panel would overflow the viewport.
        menu.classList.remove('right-0', 'bottom-full', 'mb-2');
        menu.classList.add('left-0', 'top-full', 'mt-2');
        menu.classList.remove('hidden');
        const rect = menu.getBoundingClientRect();
        if (rect.right > document.documentElement.clientWidth) {
          menu.classList.remove('left-0');
          menu.classList.add('right-0');
        }
        if (rect.bottom > document.documentElement.clientHeight) {
          menu.classList.remove('top-full', 'mt-2');
          menu.classList.add('bottom-full', 'mb-2');
        }
      } else {
        menu.classList.add('hidden');
      }
      trigger.setAttribute('aria-expanded', String(willOpen));
    });
    // Tabbing out of the dropdown closes it. A null relatedTarget (a click on
    // a non-focusable spot, or Safari not focusing a clicked item) is left to
    // the document click handler, so the item's click still lands.
    root.addEventListener('focusout', (event) => {
      const next = event.relatedTarget as Node | null;
      if (next && !root.contains(next)) close(dropdown);
    });
  }

  // Any click outside a trigger — including choosing an item — closes the panels.
  document.addEventListener('click', () => closeAll());
  // Escape closes an open panel, and puts focus back on its trigger when focus
  // was inside. Listening on the document also covers Safari, where clicking
  // the trigger doesn't focus it. preventDefault tells the header's own
  // Escape handler (mobile menu) that this keypress is taken.
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    for (const dropdown of dropdowns) {
      if (dropdown.menu.classList.contains('hidden')) continue;
      const hadFocus = dropdown.root.contains(document.activeElement);
      close(dropdown);
      if (hadFocus) dropdown.trigger.focus();
      event.preventDefault();
    }
  });
</script>
