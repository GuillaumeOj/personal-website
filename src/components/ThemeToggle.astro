---
import type { Locale } from '../config';
import { t } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<button
  type="button"
  data-theme-toggle
  aria-label={t(locale, 'theme.toggle')}
  title={t(locale, 'theme.toggle')}
  class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-line text-muted transition-colors hover:bg-surface-sunken hover:text-ink-strong"
>
  <svg
    data-theme-icon="light"
    xmlns="http://www.w3.org/2000/svg"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2"></path>
    <path d="M12 20v2"></path>
    <path d="m4.93 4.93 1.41 1.41"></path>
    <path d="m17.66 17.66 1.41 1.41"></path>
    <path d="M2 12h2"></path>
    <path d="M20 12h2"></path>
    <path d="m6.34 17.66-1.41 1.41"></path>
    <path d="m19.07 4.93-1.41 1.41"></path>
  </svg>
  <svg
    data-theme-icon="dark"
    xmlns="http://www.w3.org/2000/svg"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    class="hidden"
  >
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
  <svg
    data-theme-icon="system"
    xmlns="http://www.w3.org/2000/svg"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    class="hidden"
  >
    <rect x="2" y="3" width="20" height="14" rx="2"></rect>
    <line x1="8" y1="21" x2="16" y2="21"></line>
    <line x1="12" y1="17" x2="12" y2="21"></line>
  </svg>
</button>

<script>
  type ThemeMode = 'light' | 'dark' | 'system';
  const STORAGE_KEY = 'theme';
  const ORDER: ThemeMode[] = ['system', 'light', 'dark'];

  const isThemeMode = (value: string | null): value is ThemeMode =>
    value === 'light' || value === 'dark' || value === 'system';

  const getStoredMode = (): ThemeMode => {
    const value = localStorage.getItem(STORAGE_KEY);
    return isThemeMode(value) ? value : 'system';
  };

  const resolveAppliedTheme = (mode: ThemeMode): 'light' | 'dark' => {
    if (mode !== 'system') return mode;
    return window.matchMedia('(prefers-color-scheme: dark)').matches
      ? 'dark'
      : 'light';
  };

  const applyMode = (mode: ThemeMode): void => {
    const applied = resolveAppliedTheme(mode);
    document.documentElement.classList.toggle('dark', applied === 'dark');
    document.documentElement.dataset.themeMode = mode;
    document
      .querySelectorAll<HTMLElement>('[data-theme-icon]')
      .forEach((icon) => {
        icon.classList.toggle('hidden', icon.dataset.themeIcon !== mode);
      });
  };

  const setMode = (mode: ThemeMode): void => {
    localStorage.setItem(STORAGE_KEY, mode);
    applyMode(mode);
  };

  const cycleMode = (current: ThemeMode): ThemeMode => {
    const idx = ORDER.indexOf(current);
    return ORDER[(idx + 1) % ORDER.length];
  };

  const init = (): void => {
    applyMode(getStoredMode());
    document
      .querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')
      .forEach((btn) => {
        btn.addEventListener('click', () => {
          setMode(cycleMode(getStoredMode()));
        });
      });

    window
      .matchMedia('(prefers-color-scheme: dark)')
      .addEventListener('change', () => {
        if (getStoredMode() === 'system') applyMode('system');
      });
  };

  init();
  document.addEventListener('astro:after-swap', init);
</script>
