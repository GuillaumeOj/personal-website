---
import { type Locale, SITE } from '../../config';
import { contactPath, ensureTrailingSlash, localizedPath } from '../../i18n/ui';
import type { ContactOutcome as Outcome } from '../../lib/contact';
import { contactOutcomes } from '../../lib/contact-page';

/** Landing page of a no-JS form post: thank-you or error, per locale. */
interface Props {
  locale: Locale;
  outcome: Outcome;
}

const { locale, outcome } = Astro.props;
const copy = contactOutcomes[outcome];
const back =
  outcome === 'thanks'
    ? ensureTrailingSlash(localizedPath(locale, '/'))
    : contactPath(locale);
---

<div class="mx-auto max-w-2xl px-6 pb-24 pt-16">
  <h1 class="page-title">{copy.title[locale]}</h1>
  <p class="mt-6 text-lg leading-relaxed text-muted">
    {copy.lead[locale]}
    {
      outcome === 'error' && (
        <>
          <a href={`mailto:${SITE.email}`} class="text-accent-ink underline">
            {SITE.email}
          </a>.
        </>
      )
    }
  </p>
  <p class="mt-8">
    <a href={back} class="btn btn-primary">{copy.back[locale]}</a>
  </p>
</div>
