---
import type { Locale } from '../../config';
import { howIWork, methodology, processMore } from '../../lib/home';
import { localizedPath } from '../../i18n/ui';
import Icon from '../Icon.astro';
import Section from './Section.astro';
import SectionHeader from './SectionHeader.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const processHref = `${localizedPath(locale, '/services')}#process`;
---

<Section id="how-i-work" class="bg-surface-sunken">
  <div class="grid gap-12 lg:grid-cols-[1fr_1.4fr] lg:gap-16">
    <SectionHeader
      locale={locale}
      eyebrow={howIWork.eyebrow}
      title={howIWork.title}
      class="reveal space-y-4 lg:sticky lg:top-24 lg:self-start"
    />

    <dl class="reveal space-y-8">
      {
        howIWork.points.map((point) => (
          <div class="border-l-2 border-accent/40 pl-5">
            <dt class="font-display text-lg font-semibold text-ink-strong">
              {point.label[locale]}
            </dt>
            <dd class="mt-1.5 leading-relaxed text-muted">
              {point.desc[locale]}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>

  <div class="mt-16">
    <h3 class="reveal subheading border-t border-line pt-12">
      {methodology.title[locale]}
    </h3>
    <p class="reveal mt-3 max-w-2xl text-lg leading-relaxed text-muted">
      {methodology.lead[locale]}
    </p>

    <ol class="reveal mt-10 ml-4 list-none border-l-2 border-line p-0">
      {
        methodology.phases.map((phase, i) => (
          <li class="reveal relative pb-10 pl-10 last:pb-0">
            <span
              class="absolute left-0 top-0 flex h-9 w-9 -translate-x-1/2 items-center justify-center rounded-full bg-surface-sunken font-mono text-sm font-medium text-accent-ink ring-2 ring-accent"
              aria-hidden="true"
            >
              {i + 1}
            </span>
            <h4 class="font-display text-lg font-semibold text-ink-strong">
              {phase.label[locale]}
            </h4>
          </li>
        ))
      }
    </ol>

    <p class="reveal mt-10">
      <a href={processHref} class="btn btn-secondary">
        {processMore[locale]}
        <Icon name="arrow-right" size={15} />
      </a>
    </p>
  </div>
</Section>
