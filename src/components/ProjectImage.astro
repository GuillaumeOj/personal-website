---
import { Image } from 'astro:assets';
import type { ThemeVariants } from '../lib/projects';

interface Props {
  variants: ThemeVariants;
  alt?: string;
  class?: string;
  priority?: boolean;
  /** Candidate widths for the generated srcset (capped at the source width). */
  widths?: number[];
  /** `sizes` hint describing the rendered width across breakpoints. */
  sizes?: string;
  /**
   * WebP compression quality. Defaults below Astro's 80 — these covers are UI
   * screenshots shown small (cards) or as previews, where the extra bytes at
   * 80 aren't worth it (Lighthouse flagged the Fusily portrait for this).
   */
  quality?: number;
}

const {
  variants,
  alt = '',
  class: className = '',
  priority = false,
  widths = [400, 640, 960, 1280],
  sizes = '(min-width: 768px) 720px, 100vw',
  quality = 72,
} = Astro.props;
const { light, dark } = variants;
// Both theme variants share the loading hints: only CSS knows which one is
// visible, so a priority image must be eager in either theme (a lazy variant
// is the visible one for half the visitors otherwise).
const shared = {
  alt,
  widths,
  sizes,
  quality,
  loading: priority ? 'eager' : 'lazy',
  fetchpriority: priority ? 'high' : 'auto',
} as const;
const themed =
  light === dark
    ? [{ src: light, class: className }]
    : [
        { src: light, class: `${className} block dark:hidden` },
        { src: dark, class: `${className} hidden dark:block` },
      ];
---

{themed.map((variant) => <Image {...shared} {...variant} />)}
