---
import { SITE, type Locale } from '../config';
import { localizedPath, t } from '../i18n/ui';
import LangSwitcher from './LangSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<header
  class="sticky top-0 z-10 border-b border-zinc-200 bg-white/80 backdrop-blur dark:border-zinc-800 dark:bg-zinc-950/80"
>
  <div class="mx-auto flex max-w-3xl items-center justify-between gap-4 px-6 py-4">
    <a
      href={localizedPath(locale, '/')}
      class="text-base font-semibold tracking-tight text-zinc-900 no-underline dark:text-zinc-100"
    >
      {SITE.name}
    </a>
    <nav class="flex items-center gap-2 text-sm">
      <a
        href={localizedPath(locale, '/')}
        class="rounded-md px-2 py-1 text-zinc-600 no-underline transition-colors hover:bg-zinc-100 hover:text-zinc-900 dark:text-zinc-400 dark:hover:bg-zinc-900 dark:hover:text-zinc-100"
        >{t(locale, 'nav.home')}</a
      >
      <a
        href={localizedPath(locale, '/blog')}
        class="rounded-md px-2 py-1 text-zinc-600 no-underline transition-colors hover:bg-zinc-100 hover:text-zinc-900 dark:text-zinc-400 dark:hover:bg-zinc-900 dark:hover:text-zinc-100"
        >{t(locale, 'nav.blog')}</a
      >
      <a
        href={localizedPath(locale, '/projects')}
        class="rounded-md px-2 py-1 text-zinc-600 no-underline transition-colors hover:bg-zinc-100 hover:text-zinc-900 dark:text-zinc-400 dark:hover:bg-zinc-900 dark:hover:text-zinc-100"
        >{t(locale, 'nav.projects')}</a
      >
      <span class="mx-1 h-5 w-px bg-zinc-200 dark:bg-zinc-800" aria-hidden="true"></span>
      <LangSwitcher locale={locale} />
      <ThemeToggle locale={locale} />
    </nav>
  </div>
</header>
