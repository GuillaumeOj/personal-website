---
import AboutContent from '@/components/about/AboutContent.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { personImageUrl } from '@/lib/person-image';
import { about, aboutCrumbs, aboutJsonLd } from '@/lib/about';

const locale = 'fr' as const;
const doc = about[locale];

// Visible trail (Home › About) mirroring the BreadcrumbList JSON-LD.
const crumbs = aboutCrumbs(locale);

const personImage = await personImageUrl();
---

<BaseLayout
  locale={locale}
  title={doc.metaTitle}
  description={doc.metaDescription}
  jsonLd={aboutJsonLd(locale, personImage)}
  container="full"
  rawTitle
>
  <div class="mx-auto max-w-6xl px-6 pt-8">
    <Breadcrumb locale={locale} items={crumbs} />
  </div>
  <AboutContent locale={locale} />
</BaseLayout>
