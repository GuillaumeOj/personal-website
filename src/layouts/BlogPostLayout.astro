---
import { getImage, Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Portrait from '../components/about/Portrait.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { SITE, type Locale } from '../config';
import { articlePath, ensureTrailingSlash, formatDate, localizedPath, otherLocale, t } from '../i18n/ui';
import { OG_HEIGHT, OG_WIDTH, articleSocialImage } from '../lib/og';
import { articleAlternates } from '../lib/alternates';
import { findSibling } from '../lib/posts';
import { blogPostJsonLd } from '../lib/schema';
import type { TocHeading } from '../lib/toc';
import BaseLayout from './BaseLayout.astro';

interface Props {
  locale: Locale;
  post: CollectionEntry<'blog'>;
  headings?: TocHeading[];
}

const { locale, post, headings = [] } = Astro.props;
const { author } = post.data;
const authorName = author ?? SITE.name;

// hreflang: blog slugs differ across locales, so pair this post with its
// translated sibling (shared `translationKey`) and hand BaseLayout explicit
// alternate URLs. A post with no published sibling gets none (canonical only).
const sibling = await findSibling(post.data.translationKey, otherLocale(locale));
const { hasAlternate, altFrUrl, altEnUrl } = articleAlternates({
  locale,
  slug: post.data.slug,
  siblingSlug: sibling?.data.slug,
});

const canonical = new URL(articlePath(locale, post.data.slug), SITE.url).toString();
// Crop the cover into a real 1200×630 landscape share card. Covers are local
// assets now, so this is a build-time resize with exact dimensions — the Notion
// pipeline handed LinkedIn/Slack the raw remote URL with no width/height at all.
// JPEG (not webp) because some crawlers still refuse webp previews.
const card = await getImage({
  src: post.data.cover,
  width: OG_WIDTH,
  height: OG_HEIGHT,
  fit: 'cover',
  format: 'jpeg',
});
const og = articleSocialImage({
  cover: { url: card.src, width: OG_WIDTH, height: OG_HEIGHT },
  locale,
});
// Breadcrumb trail (Home › Blog › {title}), shared by the visible <nav> and the
// BreadcrumbList JSON-LD so both stay in lockstep.
const crumbs = [
  {
    name: t(locale, 'nav.home'),
    url: new URL(ensureTrailingSlash(localizedPath(locale, '/')), SITE.url).toString(),
  },
  {
    name: t(locale, 'nav.blog'),
    url: new URL(ensureTrailingSlash(localizedPath(locale, '/blog')), SITE.url).toString(),
  },
  { name: post.data.title, url: canonical },
];
// BlogPosting + breadcrumb (Home › Blog › {title}). Author falls back to the
// site Person inside the builder when a post has none.
const jsonLd = blogPostJsonLd(locale, {
  url: canonical,
  title: post.data.title,
  description: post.data.description,
  image: new URL(og.url, SITE.url).toString(),
  datePublished: post.data.pubDate.toISOString(),
  // Left undefined for the site author on purpose: the builder then points at
  // the canonical `#person` node instead of inlining a second, unlinked Person.
  authorName: author,
  breadcrumbs: crumbs,
});
---

<BaseLayout
  locale={locale}
  title={post.data.title}
  description={post.data.description}
  ogImage={og.url}
  ogImageWidth={og.width}
  ogImageHeight={og.height}
  ogImageAlt={post.data.coverAlt ?? post.data.title}
  ogType="article"
  articleMeta={{
    publishedTime: post.data.pubDate.toISOString(),
    author: authorName,
    tags: post.data.tags,
  }}
  jsonLd={jsonLd}
  hreflang={hasAlternate}
  altFrUrl={altFrUrl}
  altEnUrl={altEnUrl}
>
  <TableOfContents locale={locale} headings={headings} />
  <a
    href={localizedPath(locale, '/blog')}
    class="fixed top-24 z-10 hidden w-52 text-sm text-accent-ink no-underline hover:underline xl:block left-[max(1.5rem,calc(50%-39rem))]"
  >
    {t(locale, 'blog.backToList')}
  </a>
  <article class="space-y-6">
    <Breadcrumb items={crumbs.map((c) => ({ name: c.name, href: c.url }))} />
    <Image
      src={post.data.cover}
      alt={post.data.coverAlt ?? post.data.title}
      widths={[640, 960, 1280, 1600]}
      sizes="(min-width: 768px) 768px, 100vw"
      loading="eager"
      fetchpriority="high"
      class="aspect-[3/1] w-full rounded-2xl object-cover"
    />
    <header class="space-y-2">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-muted">
        <p>
          <span>{t(locale, 'blog.published')}</span>{' '}
          <time datetime={post.data.pubDate.toISOString()}>
            {formatDate(post.data.pubDate, locale)}
          </time>
        </p>
        <span class="inline-flex items-center gap-2">
          {
            !author && (
              <Portrait
                locale={locale}
                width={24}
                height={24}
                decorative
                class="h-6 w-6 ring-0"
              />
            )
          }
          <span>{authorName}</span>
        </span>
      </div>
      <h1 class="page-title">{post.data.title}</h1>
      <p class="text-lg text-muted">
        {post.data.description}
      </p>
    </header>

    <div
      class="prose prose-stone max-w-none dark:prose-invert prose-headings:tracking-tight prose-a:underline-offset-4 prose-h2:scroll-mt-24"
    >
      <slot />
    </div>

    {/* End-of-article conversion block: an author card (the visible human behind
        the BlogPosting author Person) plus CTAs, so a post isn't a dead-end. */}
    <footer class="not-prose mt-14 space-y-6 rounded-2xl border border-line bg-surface p-6 sm:p-8">
      <div class="flex items-start gap-4">
        <Portrait locale={locale} class="h-14 w-14 shrink-0" loading="lazy" />
        <div class="space-y-1">
          <p class="font-display font-semibold text-ink-strong">{SITE.name}</p>
          <p class="text-sm leading-relaxed text-muted">{t(locale, 'blog.cta.bio')}</p>
        </div>
      </div>
      <div class="space-y-3 border-t border-line pt-6">
        <p class="font-display text-lg font-semibold tracking-tight text-ink-strong">
          {t(locale, 'blog.cta.heading')}
        </p>
        <p class="leading-relaxed text-muted">{t(locale, 'blog.cta.lead')}</p>
        <div class="flex flex-wrap gap-3 pt-1">
          <a href={`${localizedPath(locale, '/')}#contact`} class="btn btn-primary">
            {t(locale, 'blog.cta.primary')}
          </a>
          <a href={localizedPath(locale, '/services')} class="btn btn-secondary">
            {t(locale, 'blog.cta.secondary')}
          </a>
        </div>
      </div>
    </footer>
  </article>
</BaseLayout>
