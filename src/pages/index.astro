---
import { getImage } from 'astro:assets';
import portrait from '../assets/portrait.jpg';
import AboutTeaser from '../components/home/AboutTeaser.astro';
import Contact from '../components/home/Contact.astro';
import FeaturedProjects from '../components/home/FeaturedProjects.astro';
import Hero from '../components/home/Hero.astro';
import HowIWork from '../components/home/HowIWork.astro';
import WhatIDo from '../components/home/WhatIDo.astro';
import { SITE } from '../config';
import BaseLayout from '../layouts/BaseLayout.astro';
import { portraitAlt } from '../lib/about';

const locale = 'fr' as const;

// A JPEG rendition of the portrait for social sharing (JPEG for broad
// compatibility, e.g. LinkedIn), same as the about page.
const ogImage = new URL(
  (await getImage({ src: portrait, format: 'jpeg', quality: 80 })).src,
  SITE.url,
).toString();
---

<BaseLayout
  locale={locale}
  title={SITE.name}
  description="Guillaume Ojardias, développeur fullstack freelance — applications web et mobiles, du frontend au backend jusqu’au déploiement. Python/Django, React Native, Next.js, PostgreSQL."
  ogImage={ogImage}
  ogImageAlt={portraitAlt[locale]}
  container="full"
  snap
>
  <Hero locale={locale} />
  <WhatIDo locale={locale} />
  <HowIWork locale={locale} />
  <FeaturedProjects locale={locale} />
  <Contact locale={locale} />
  <AboutTeaser locale={locale} />
</BaseLayout>
