---
import type { Locale } from '../config';
import { articlePath, localizedPath, otherLocale, t } from '../i18n/ui';
import { findSibling } from '../lib/posts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const target = otherLocale(locale);

const currentPath = Astro.url.pathname;
const articleMatch = currentPath.match(
  /^(?:\/en)?\/blog\/([^/]+)\/([^/]+)\/?$/,
);

let normalized: string;

if (articleMatch) {
  const [, translationKey] = articleMatch;
  const sibling = await findSibling(translationKey, target);
  normalized = sibling
    ? articlePath(target, translationKey, sibling.data.slug)
    : `${localizedPath(target, '/blog')}/`;
} else {
  const stripped =
    locale === 'en' ? currentPath.replace(/^\/en(\/|$)/, '/') : currentPath;
  const targetPath =
    target === 'fr' ? stripped : `/en${stripped === '/' ? '' : stripped}`;
  normalized = targetPath.endsWith('/') ? targetPath : `${targetPath}/`;
}
---

<a
  href={normalized}
  hreflang={target}
  data-lang-switcher
  aria-label={t(locale, 'lang.switch')}
  class="inline-flex h-9 items-center justify-center rounded-md border border-line px-3 text-sm font-medium uppercase tracking-wide text-muted no-underline transition-colors hover:bg-surface-sunken hover:text-ink-strong"
>
  {target}
</a>
