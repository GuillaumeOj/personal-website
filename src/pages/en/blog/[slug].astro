---
import { articlePath } from '../../../i18n/ui';
import { getPostsForLocale } from '../../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPostsForLocale('en');
  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: {
      target: articlePath('en', post.data.translationKey, post.data.slug),
    },
  }));
}

return Astro.redirect((Astro.props as { target: string }).target, 301);
---
