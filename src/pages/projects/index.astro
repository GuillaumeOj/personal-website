---
import ProjectsExplorer from '@/components/ProjectsExplorer.astro';
import { contactPath, t } from '@/i18n/ui';
import HubLayout from '@/layouts/HubLayout.astro';
import { getProjects } from '@/lib/projects';

const locale = 'fr' as const;
const projects = getProjects();
---

<HubLayout
  locale={locale}
  path="/projects"
  crumb={t(locale, 'nav.projects')}
  metaTitle={t(locale, 'meta.projectsTitle')}
  metaDescription={t(locale, 'meta.projectsDescription')}
  heading={t(locale, 'projects.title')}
  subtitle={t(locale, 'projects.subtitle')}
>
  <div class="mt-10">
    <ProjectsExplorer projects={projects} locale={locale} />
  </div>

  <section class="mt-16 border-t border-line pt-10 text-center">
    <p class="text-lg text-ink-strong">{t(locale, 'projects.listCta.title')}</p>
    <a href={contactPath(locale)} class="btn btn-primary mt-5">
      {t(locale, 'projects.listCta.link')}
    </a>
  </section>
</HubLayout>
