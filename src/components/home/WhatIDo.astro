---
import type { Locale } from '../../config';
import { whatIDo, whatIDoMore } from '../../lib/home';
import { localizedPath } from '../../i18n/ui';
import Icon from '../Icon.astro';
import NumberedCards from '../lists/NumberedCards.astro';
import Section from './Section.astro';
import SectionHeader from './SectionHeader.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const servicesHref = localizedPath(locale, '/services');
---

<Section id="services">
  <SectionHeader
    locale={locale}
    eyebrow={whatIDo.eyebrow}
    title={whatIDo.title}
    lead={whatIDo.lead}
  />

  <NumberedCards locale={locale} items={whatIDo.pillars} />

  <p class="reveal mt-10">
    <a href={servicesHref} class="btn btn-secondary">
      {whatIDoMore[locale]}
      <Icon name="arrow-right" size={15} />
    </a>
  </p>
</Section>
