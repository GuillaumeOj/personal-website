---
import Breadcrumb from '../../../components/Breadcrumb.astro';
import ProjectsExplorer from '../../../components/ProjectsExplorer.astro';
import { SITE } from '../../../config';
import { ensureTrailingSlash, localizedPath, t } from '../../../i18n/ui';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getProjects } from '../../../lib/projects';
import { collectionPageJsonLd } from '../../../lib/schema';

const locale = 'en' as const;
const projects = getProjects();

const canonical = new URL(
  ensureTrailingSlash(localizedPath(locale, '/projects')),
  SITE.url,
).toString();
const jsonLd = collectionPageJsonLd(locale, {
  url: canonical,
  name: t(locale, 'meta.projectsTitle'),
  description: t(locale, 'meta.projectsDescription'),
  breadcrumbs: [
    { name: t(locale, 'nav.home'), url: new URL(ensureTrailingSlash(localizedPath(locale, '/')), SITE.url).toString() },
    { name: t(locale, 'nav.projects'), url: canonical },
  ],
});

// Visible trail (Home › Projects) mirroring the BreadcrumbList JSON-LD.
const crumbs = [
  {
    name: t(locale, 'nav.home'),
    href: new URL(ensureTrailingSlash(localizedPath(locale, '/')), SITE.url).toString(),
  },
  { name: t(locale, 'nav.projects'), href: canonical },
];
---

<BaseLayout
  locale={locale}
  title={t(locale, 'meta.projectsTitle')}
  description={t(locale, 'meta.projectsDescription')}
  jsonLd={jsonLd}
  container="full"
  hreflang
>
  <div class="mx-auto max-w-6xl px-6 pt-8">
    <Breadcrumb items={crumbs} />
  </div>
  <div class="mx-auto max-w-6xl px-6 py-12 sm:py-16">
    <section class="max-w-2xl space-y-3">
      <h1 class="page-title">{t(locale, 'projects.title')}</h1>
      <p class="text-lg text-muted">{t(locale, 'projects.subtitle')}</p>
    </section>

    <div class="mt-10">
      <ProjectsExplorer projects={projects} locale={locale} />
    </div>

    <section class="mt-16 border-t border-line pt-10 text-center">
      <p class="text-lg text-ink-strong">{t(locale, 'projects.listCta.title')}</p>
      <a href={`${localizedPath(locale, '/')}#contact`} class="btn btn-primary mt-5">
        {t(locale, 'projects.listCta.link')}
      </a>
    </section>
  </div>
</BaseLayout>
