---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import TableOfContents from '../components/TableOfContents.astro';
import type { Locale } from '../config';
import { formatDate, localizedPath, t } from '../i18n/ui';
import type { TocHeading } from '../lib/notion';
import BaseLayout from './BaseLayout.astro';

interface Props {
  locale: Locale;
  post: CollectionEntry<'blog'>;
  headings?: TocHeading[];
}

const { locale, post, headings = [] } = Astro.props;
const { author } = post.data;
---

<BaseLayout
  locale={locale}
  title={post.data.title}
  description={post.data.description}
  ogImage={post.data.cover}
>
  <TableOfContents locale={locale} headings={headings} />
  <a
    href={localizedPath(locale, '/blog')}
    class="fixed top-24 z-10 hidden w-52 text-sm text-accent-ink no-underline hover:underline xl:block left-[max(1.5rem,calc(50%-39rem))]"
  >
    {t(locale, 'blog.backToList')}
  </a>
  <article class="space-y-6">
    <a
      href={localizedPath(locale, '/blog')}
      class="inline-block text-sm text-accent-ink no-underline hover:underline xl:hidden"
    >
      {t(locale, 'blog.backToList')}
    </a>
    {
      post.data.cover && (
        <Image
          src={post.data.cover}
          inferSize
          alt=""
          loading="eager"
          fetchpriority="high"
          class="aspect-[3/1] w-full rounded-2xl object-cover"
        />
      )
    }
    <header class="space-y-2">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-muted">
        <p>
          <span>{t(locale, 'blog.published')}</span>{' '}
          <time datetime={post.data.pubDate.toISOString()}>
            {formatDate(post.data.pubDate, locale)}
          </time>
        </p>
        {
          author && (
            <span class="inline-flex items-center gap-2">
              {author.avatarUrl && (
                <img
                  src={author.avatarUrl}
                  alt=""
                  loading="lazy"
                  class="h-6 w-6 rounded-full object-cover"
                />
              )}
              <span>{author.name}</span>
            </span>
          )
        }
      </div>
      <h1 class="page-title">{post.data.title}</h1>
      <p class="text-lg text-muted">
        {post.data.description}
      </p>
    </header>

    <div
      class="prose prose-stone max-w-none dark:prose-invert prose-headings:tracking-tight prose-a:underline-offset-4 prose-h2:scroll-mt-24"
    >
      <slot />
    </div>
  </article>
</BaseLayout>
