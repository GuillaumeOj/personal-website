---
import Breadcrumb from '@/components/Breadcrumb.astro';
import type { Locale } from '@/config';
import { localizedUrl, type TranslationKey, t } from '@/i18n/ui';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { collectionPageJsonLd, navTrail } from '@/lib/schema';

// A section index (blog, projects): Home › Section breadcrumb, a
// CollectionPage JSON-LD, the page heading, the list in the default slot and
// an optional `after` block. Each section's path and copy keys live here.
const SECTIONS = {
  blog: {
    path: '/blog',
    nav: 'nav.blog',
    metaTitle: 'meta.blogTitle',
    metaDescription: 'meta.blogDescription',
    heading: 'blog.title',
    subtitle: 'blog.subtitle',
  },
  projects: {
    path: '/projects',
    nav: 'nav.projects',
    metaTitle: 'meta.projectsTitle',
    metaDescription: 'meta.projectsDescription',
    heading: 'projects.title',
    subtitle: 'projects.subtitle',
  },
} as const satisfies Record<
  string,
  { path: string } & Record<
    'nav' | 'metaTitle' | 'metaDescription' | 'heading' | 'subtitle',
    TranslationKey
  >
>;

interface Props {
  locale: Locale;
  section: keyof typeof SECTIONS;
}

const { locale, section } = Astro.props;
const { path, nav } = SECTIONS[section];
const metaTitle = t(locale, SECTIONS[section].metaTitle);
const metaDescription = t(locale, SECTIONS[section].metaDescription);

const canonical = localizedUrl(locale, path);
const crumbs = navTrail(locale, [nav, path]);
const jsonLd = collectionPageJsonLd(locale, {
  url: canonical,
  name: metaTitle,
  description: metaDescription,
  breadcrumbs: crumbs,
});
---

<BaseLayout
  locale={locale}
  title={metaTitle}
  description={metaDescription}
  jsonLd={jsonLd}
  container="full"
>
  <div class="mx-auto max-w-6xl px-6 pt-8">
    <Breadcrumb locale={locale} items={crumbs} />
  </div>
  <div class="mx-auto max-w-6xl px-6 py-12 sm:py-16">
    <section class="max-w-2xl space-y-3">
      <h1 class="page-title">{t(locale, SECTIONS[section].heading)}</h1>
      <p class="text-lg text-muted">{t(locale, SECTIONS[section].subtitle)}</p>
    </section>

    <div class="mt-10">
      <slot />
    </div>
    <slot name="after" />
  </div>
</BaseLayout>
