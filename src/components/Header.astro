---
import { SITE, type Locale } from '../config';
import { localizedPath, navItems, t } from '../i18n/ui';
import LangSwitcher from './LangSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const home = localizedPath(locale, '/');
const links = navItems(locale);
const linkClass =
  'rounded-md px-2.5 py-1 text-muted no-underline transition-colors hover:bg-surface-sunken hover:text-ink-strong';
---

<header
  class="sticky top-0 z-20 border-b border-line bg-paper/80 backdrop-blur"
  data-header
>
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-6 py-4">
    <a
      href={home}
      class="font-display text-base font-semibold tracking-tight text-ink-strong no-underline"
    >
      {SITE.name}
    </a>

    {/* Desktop nav */}
    <nav class="hidden items-center gap-1 text-sm md:flex">
      {links.map((link) => (
        <a href={link.href} class={linkClass}>{link.label}</a>
      ))}
      <span class="mx-1 h-5 w-px bg-line" aria-hidden="true"></span>
      <LangSwitcher locale={locale} />
      <ThemeToggle locale={locale} />
    </nav>

    {/* Mobile burger */}
    <button
      type="button"
      class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-line text-muted transition-colors hover:bg-surface-sunken hover:text-ink-strong md:hidden"
      data-menu-toggle
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label={t(locale, 'nav.menu')}
    >
      <svg
        data-menu-icon="open"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        class="h-5 w-5"
        aria-hidden="true"
      >
        <path d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
      <svg
        data-menu-icon="close"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        class="hidden h-5 w-5"
        aria-hidden="true"
      >
        <path d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>
  </div>

  {/* Mobile menu panel */}
  <div
    id="mobile-menu"
    class="hidden border-t border-line md:hidden"
    data-menu-panel
  >
    <nav class="mx-auto flex max-w-6xl flex-col gap-1 px-6 py-4">
      {links.map((link) => (
        <a href={link.href} class:list={[linkClass, 'py-2']}>{link.label}</a>
      ))}
      <div class="mt-2 flex items-center gap-2 border-t border-line pt-4">
        <LangSwitcher locale={locale} />
        <ThemeToggle locale={locale} />
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const panel = document.querySelector<HTMLElement>('[data-menu-panel]');
  if (toggle && panel) {
    const openIcon = toggle.querySelector<SVGElement>('[data-menu-icon="open"]');
    const closeIcon = toggle.querySelector<SVGElement>('[data-menu-icon="close"]');

    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      panel.classList.toggle('hidden', !open);
      openIcon?.classList.toggle('hidden', open);
      closeIcon?.classList.toggle('hidden', !open);
    };

    toggle.addEventListener('click', () =>
      setOpen(panel.classList.contains('hidden')),
    );
    // Close after following a link (section anchors, page changes).
    panel.querySelectorAll('a').forEach((link) =>
      link.addEventListener('click', () => setOpen(false)),
    );
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setOpen(false);
    });
  }
</script>
