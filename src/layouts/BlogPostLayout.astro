---
import { getImage, Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Portrait from '@/components/about/Portrait.astro';
import AuthorByline from '@/components/AuthorByline.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import TableOfContents from '@/components/TableOfContents.astro';
import { SITE, type Locale } from '@/config';
import { absoluteUrl, articlePath, contactPath, formatDate, localizedPath, otherLocale, projectPath, t } from '@/i18n/ui';
import { OG_HEIGHT, OG_WIDTH } from '@/lib/og';
import { articleAlternates } from '@/lib/alternates';
import { findSibling } from '@/lib/posts';
import { localizedName } from '@/lib/projects';
import { projectsForPost, relatedPosts } from '@/lib/related';
import { blogPostJsonLd } from '@/lib/schema';
import type { TocHeading } from '@/lib/toc';
import BaseLayout from './BaseLayout.astro';

interface Props {
  locale: Locale;
  post: CollectionEntry<'blog'>;
  headings?: TocHeading[];
}

const { locale, post, headings = [] } = Astro.props;
const { author } = post.data;
const authorName = author ?? SITE.name;
const credit = post.data.coverCredit;
const unsplashLink = (url: string) => `${url}?utm_source=guillaume_ojardias&utm_medium=referral`;

// Blog slugs differ across locales, so pair this post with its translated
// sibling (shared `translationKey`) for hreflang and the language switcher. A
// post with no published sibling gets no hreflang (canonical only).
const sibling = await findSibling(post.data.translationKey, otherLocale(locale));
const aboutProjects = projectsForPost(post);
const furtherReading = await relatedPosts(post, locale, 2);
const { alternates, paired } = articleAlternates({
  locale,
  slug: post.data.slug,
  siblingSlug: sibling?.data.slug,
});

const canonical = absoluteUrl(articlePath(locale, post.data.slug));
// Crop the cover into a real 1200×630 landscape share card. Covers are local
// assets now, so this is a build-time resize with exact dimensions — the Notion
// pipeline handed LinkedIn/Slack the raw remote URL with no width/height at all.
// JPEG (not webp) because some crawlers still refuse webp previews.
const card = await getImage({
  src: post.data.cover,
  width: OG_WIDTH,
  height: OG_HEIGHT,
  fit: 'cover',
  format: 'jpeg',
});
// Breadcrumb trail (Home › Blog › {title}), shared by the visible <nav> and the
// BreadcrumbList JSON-LD so both stay in lockstep.
const crumbs = [
  {
    name: t(locale, 'nav.home'),
    url: absoluteUrl(localizedPath(locale, '/')),
  },
  {
    name: t(locale, 'nav.blog'),
    url: absoluteUrl(localizedPath(locale, '/blog')),
  },
  { name: post.data.title, url: canonical },
];
// BlogPosting + breadcrumb (Home › Blog › {title}). Author falls back to the
// site Person inside the builder when a post has none.
const jsonLd = blogPostJsonLd(locale, {
  url: canonical,
  title: post.data.title,
  description: post.data.description,
  image: new URL(card.src, SITE.url).toString(),
  datePublished: post.data.pubDate.toISOString(),
  dateModified: post.data.updatedDate?.toISOString(),
  // Left undefined for the site author on purpose: the builder then points at
  // the canonical `#person` node instead of inlining a second, unlinked Person.
  authorName: author,
  breadcrumbs: crumbs,
});
---

<BaseLayout
  locale={locale}
  title={post.data.seoTitle ?? post.data.title}
  description={post.data.seoDescription ?? post.data.description}
  ogImage={card.src}
  ogImageWidth={OG_WIDTH}
  ogImageHeight={OG_HEIGHT}
  ogImageAlt={post.data.title}
  ogType="article"
  articleMeta={{
    publishedTime: post.data.pubDate.toISOString(),
    modifiedTime: post.data.updatedDate?.toISOString(),
    author: authorName,
    tags: post.data.tags,
  }}
  jsonLd={jsonLd}
  alternates={alternates}
  hreflang={paired}
>
  <TableOfContents locale={locale} headings={headings} />
  <a
    href={localizedPath(locale, '/blog')}
    class="fixed top-24 z-10 hidden w-52 text-sm text-accent-ink no-underline hover:underline xl:block left-[max(1.5rem,calc(50%-39rem))]"
  >
    {t(locale, 'blog.backToList')}
  </a>
  <article class="space-y-6">
    <Breadcrumb locale={locale} items={crumbs.map((c) => ({ name: c.name, href: c.url }))} />
    {/* width/height pin the 3:1 crop so sharp does it at build. Without them
        Astro keeps the source aspect (the covers are portraits up to 1600×2400)
        and `object-cover` throws ~3/4 of every byte away in the browser — on the
        LCP element. */}
    <figure class="space-y-2">
      <Image
        src={post.data.cover}
        alt={post.data.title}
        width={1600}
        height={533}
        fit="cover"
        widths={[640, 960, 1280, 1600]}
        sizes="(min-width: 768px) 768px, 100vw"
        loading="eager"
        fetchpriority="high"
        class="aspect-[3/1] w-full rounded-2xl object-cover"
      />
      {/* Covers are third-party stock: credit the photographer, linked back
          with the referral params Unsplash's attribution guidelines ask for. */}
      <figcaption class="text-right text-xs text-muted">
        {t(locale, 'blog.coverCredit.by')}{' '}
        <a href={unsplashLink(credit.authorUrl)} class="underline underline-offset-2 hover:text-accent-ink">
          {credit.author}
        </a>{' '}
        {t(locale, 'blog.coverCredit.on')}{' '}
        <a href={unsplashLink(credit.url)} class="underline underline-offset-2 hover:text-accent-ink">
          Unsplash
        </a>
      </figcaption>
    </figure>
    <header class="space-y-2">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-muted">
        <p>
          <span>{t(locale, 'blog.published')}</span>{' '}
          <time datetime={post.data.pubDate.toISOString()}>
            {formatDate(post.data.pubDate, locale)}
          </time>
        </p>
        {
          post.data.updatedDate && (
            <p>
              <span>{t(locale, 'blog.updated')}</span>{' '}
              <time datetime={post.data.updatedDate.toISOString()}>
                {formatDate(post.data.updatedDate, locale)}
              </time>
            </p>
          )
        }
        <AuthorByline locale={locale} author={author} />
      </div>
      <h1 class="page-title">{post.data.title}</h1>
      <p class="text-lg text-muted">
        {post.data.description}
      </p>
    </header>

    <div
      class="prose prose-stone max-w-none dark:prose-invert prose-headings:tracking-tight prose-a:underline-offset-4"
    >
      <slot />
    </div>

    {
      aboutProjects.length > 0 && (
        <p class="not-prose mt-10 text-muted">
          {t(locale, aboutProjects.length > 1 ? 'blog.aboutProjects' : 'blog.aboutProject')}{' '}
          {aboutProjects.map((project, i) => (
            <>
              {i > 0 && ', '}
              <a href={projectPath(locale, project.slug)} class="font-medium text-accent-ink">
                {localizedName(project, locale)}
              </a>
            </>
          ))}
        </p>
      )
    }

    {/* End-of-article conversion block: an author card (the visible human behind
        the BlogPosting author Person) plus CTAs, so a post isn't a dead-end. */}
    <footer class="not-prose mt-14 space-y-6 rounded-2xl border border-line bg-surface p-6 sm:p-8">
      <div class="flex items-start gap-4">
        <Portrait locale={locale} class="h-14 w-14 shrink-0" loading="lazy" />
        <div class="space-y-1">
          <p class="font-display font-semibold text-ink-strong">{SITE.name}</p>
          <p class="text-sm leading-relaxed text-muted">{t(locale, 'blog.cta.bio')}</p>
        </div>
      </div>
      <div class="space-y-3 border-t border-line pt-6">
        <p class="font-display text-lg font-semibold tracking-tight text-ink-strong">
          {t(locale, 'blog.cta.heading')}
        </p>
        <p class="leading-relaxed text-muted">{t(locale, 'blog.cta.lead')}</p>
        <div class="flex flex-wrap gap-3 pt-1">
          <a href={contactPath(locale)} class="btn btn-primary">
            {t(locale, 'blog.cta.primary')}
          </a>
          <a href={localizedPath(locale, '/services')} class="btn btn-secondary">
            {t(locale, 'blog.cta.secondary')}
          </a>
        </div>
      </div>
    </footer>
  </article>

  {
    furtherReading.length > 0 && (
      <section class="mt-16 space-y-6">
        <h2 class="font-display text-2xl font-semibold tracking-tight text-ink-strong">
          {t(locale, 'blog.related')}
        </h2>
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
          {furtherReading.map((other) => (
            <ArticleCard
              post={other}
              locale={locale}
              headingLevel={3}
              sizes="(min-width: 768px) 348px, (min-width: 640px) 50vw, 100vw"
            />
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>
