---
import AboutTeaser from '@/components/home/AboutTeaser.astro';
import ContactCta from '@/components/ContactCta.astro';
import FeaturedProjects from '@/components/home/FeaturedProjects.astro';
import Hero from '@/components/home/Hero.astro';
import HowIWork from '@/components/home/HowIWork.astro';
import WhatIDo from '@/components/home/WhatIDo.astro';
import { getImage } from 'astro:assets';
import portrait from '@/assets/portrait.jpg';
import { SITE } from '@/config';
import { t } from '@/i18n/ui';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { homeJsonLd } from '@/lib/schema';

const locale = 'fr' as const;

// A JPEG rendition of the portrait for the Person node's `image`.
const personImage = new URL(
  (await getImage({ src: portrait, format: 'jpeg', quality: 80 })).src,
  SITE.url,
).toString();
---

<BaseLayout
  locale={locale}
  title={t(locale, 'meta.homeTitle')}
  description={t(locale, 'meta.homeDescription')}
  jsonLd={homeJsonLd(locale, personImage)}
  container="full"
  snap
>
  <Hero locale={locale} />
  <WhatIDo locale={locale} />
  <HowIWork locale={locale} />
  <FeaturedProjects locale={locale} />
  <AboutTeaser locale={locale} />
  <ContactCta locale={locale} />
</BaseLayout>
