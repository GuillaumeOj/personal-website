---
import type { Locale } from '../../config';

// A vertical numbered timeline: the home methodology teaser (labels only, under
// an h3) and the services project flow (with descriptions).
interface Props {
  locale: Locale;
  items: { label: Record<Locale, string>; desc?: Record<Locale, string> }[];
  /** Heading level of each step, one below the surrounding section heading. */
  headingLevel?: 'h3' | 'h4';
}

const { locale, items, headingLevel: Heading = 'h3' } = Astro.props;
---

<ol class="reveal mt-10 ml-4 list-none border-l-2 border-line p-0">
  {
    items.map((item, i) => (
      <li class="reveal relative pb-10 pl-10 last:pb-0">
        <span
          class="absolute left-0 top-0 flex h-9 w-9 -translate-x-1/2 items-center justify-center rounded-full bg-surface-sunken font-mono text-sm font-medium text-accent-ink ring-2 ring-accent"
          aria-hidden="true"
        >
          {i + 1}
        </span>
        <Heading class="font-display text-lg font-semibold text-ink-strong">
          {item.label[locale]}
        </Heading>
        {item.desc && (
          <p class="mt-1.5 max-w-xl leading-relaxed text-muted">
            {item.desc[locale]}
          </p>
        )}
      </li>
    ))
  }
</ol>
