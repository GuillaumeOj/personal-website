---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../config';
import { articlePath, formatDate } from '../i18n/ui';

interface Props {
  post: CollectionEntry<'blog'>;
  locale: Locale;
  priority?: boolean;
}

const { post, locale, priority = false } = Astro.props;
const href = articlePath(locale, post.data.translationKey, post.data.slug);
const { author } = post.data;
---

<a
  href={href}
  class="group flex flex-col overflow-hidden rounded-lg border border-zinc-200 no-underline transition-[transform,box-shadow,border-color] duration-300 ease-out hover:-translate-y-1 hover:border-zinc-300 hover:shadow-lg dark:border-zinc-800 dark:hover:border-zinc-700 dark:hover:shadow-black/40"
>
  {
    post.data.cover ? (
      <div class="aspect-[16/9] w-full overflow-hidden">
        <img
          src={post.data.cover}
          alt=""
          loading={priority ? 'eager' : 'lazy'}
          fetchpriority={priority ? 'high' : 'auto'}
          class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
        />
      </div>
    ) : (
      <div class="aspect-[16/9] w-full bg-gradient-to-br from-zinc-100 to-zinc-200 dark:from-zinc-900 dark:to-zinc-800" />
    )
  }
  <div class="flex flex-1 flex-col gap-2 p-4">
    <h3 class="text-base font-semibold tracking-tight text-zinc-900 group-hover:underline dark:text-zinc-100">
      {post.data.title}
    </h3>
    <p class="line-clamp-3 text-sm text-zinc-600 dark:text-zinc-400">
      {post.data.description}
    </p>
    <div class="mt-auto flex flex-wrap items-center gap-x-3 gap-y-1 pt-2 text-xs text-zinc-500 dark:text-zinc-400">
      <time datetime={post.data.pubDate.toISOString()}>
        {formatDate(post.data.pubDate, locale)}
      </time>
      {
        author && (
          <span class="inline-flex items-center gap-1.5">
            {author.avatarUrl && (
              <img
                src={author.avatarUrl}
                alt=""
                loading="lazy"
                class="h-5 w-5 rounded-full object-cover"
              />
            )}
            <span>{author.name}</span>
          </span>
        )
      }
    </div>
  </div>
</a>
