---
import type { CollectionEntry } from 'astro:content';
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';
import { renderPostBody } from '../../../../lib/notion';
import { getPostsForLocale } from '../../../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPostsForLocale('en');
  return posts.map((post) => ({
    params: {
      translationKey: post.data.translationKey,
      slug: post.data.slug,
    },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { html, headings } = await renderPostBody(post);
---

<BlogPostLayout locale="en" post={post} headings={headings}>
  <Fragment set:html={html} />
</BlogPostLayout>
