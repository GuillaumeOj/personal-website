---
import { SITE } from '../../config';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../i18n/ui';

const locale = 'en' as const;
---

<BaseLayout
  locale={locale}
  title={SITE.name}
  description="Personal site of Guillaume Ojardias — Python backend developer and beginner project manager. Notes, projects, and a blog in French and English."
>
  <section class="space-y-6">
    <p class="text-sm uppercase tracking-wide text-zinc-500">
      {t(locale, 'home.tagline')}
    </p>
    <h1 class="text-4xl font-bold tracking-tight text-zinc-900 sm:text-5xl dark:text-zinc-100">
      {t(locale, 'home.intro.title')}
    </h1>
    <div class="space-y-4 text-lg leading-relaxed text-zinc-700 dark:text-zinc-300">
      <p>
        I have been building Python backends for several years — APIs, data pipelines,
        observability — and I am training in project management so I can coordinate teams
        around problems I already know how to solve technically.
      </p>
      <p>
        On this site you will find a blog where I write down what I am learning, especially
        about the dev → project manager transition, and a few more technical retrospectives.
      </p>
    </div>

    <div class="flex flex-wrap gap-3 pt-2">
      <a
        href="/en/blog/"
        class="inline-flex items-center rounded-md bg-zinc-900 px-4 py-2 text-sm font-medium text-white no-underline transition-colors hover:bg-zinc-700 dark:bg-zinc-100 dark:text-zinc-900 dark:hover:bg-zinc-300"
      >
        {t(locale, 'home.cta.blog')}
      </a>
    </div>
  </section>

  <section class="mt-16 space-y-4">
    <h2 class="text-xl font-semibold tracking-tight text-zinc-900 dark:text-zinc-100">
      {t(locale, 'home.contact.title')}
    </h2>
    <ul class="space-y-2 text-zinc-700 list-none p-0 dark:text-zinc-300">
      <li>
        <span class="text-zinc-500">{t(locale, 'home.contact.email')} —</span>{' '}
        <a href={`mailto:${SITE.social.email}`}>{SITE.social.email}</a>
      </li>
      <li>
        <span class="text-zinc-500">{t(locale, 'home.contact.github')} —</span>{' '}
        <a href={SITE.social.github} rel="me noopener">{SITE.social.github.replace('https://', '')}</a>
      </li>
      <li>
        <span class="text-zinc-500">{t(locale, 'home.contact.linkedin')} —</span>{' '}
        <a href={SITE.social.linkedin} rel="me noopener">{SITE.social.linkedin.replace('https://', '')}</a>
      </li>
    </ul>
  </section>
</BaseLayout>
