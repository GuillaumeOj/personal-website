---
import type { Locale } from '../config';
import { projectPath, t } from '../i18n/ui';
import { localizedName, type Project, resolveImage } from '../lib/projects';
import ProjectImage from './ProjectImage.astro';

interface Props {
  project: Project;
  locale: Locale;
  priority?: boolean;
}

const { project, locale, priority = false } = Astro.props;
const href = projectPath(locale, project.slug);
const { description } = project.content[locale];
const contextLabel = t(locale, `projects.context.${project.context}`);
const cover = resolveImage(project.cover, locale);
const name = localizedName(project, locale);
const tags = project.stack.slice(0, 3);
---

<a
  href={href}
  class="group flex flex-col overflow-hidden rounded-lg border border-zinc-200 no-underline transition-[transform,box-shadow,border-color] duration-300 ease-out hover:-translate-y-1 hover:border-zinc-300 hover:shadow-lg dark:border-zinc-800 dark:hover:border-zinc-700 dark:hover:shadow-black/40"
>
  <div class="aspect-[16/9] w-full overflow-hidden">
    <ProjectImage
      variants={cover}
      priority={priority}
      sizes="(min-width: 640px) 360px, 100vw"
      class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
    />
  </div>
  <div class="flex flex-1 flex-col gap-2 p-4">
    <div class="flex items-center justify-between gap-2">
      <h3 class="text-base font-semibold tracking-tight text-zinc-900 group-hover:underline dark:text-zinc-100">
        {name}
      </h3>
      <span class="shrink-0 text-xs text-zinc-500 dark:text-zinc-400">
        {contextLabel}
      </span>
    </div>
    <p class="line-clamp-3 text-sm text-zinc-600 dark:text-zinc-400">
      {description}
    </p>
    {
      tags.length > 0 && (
        <div class="mt-auto flex flex-wrap gap-1.5 pt-2">
          {tags.map((tag) => (
            <span class="rounded bg-zinc-100 px-2 py-0.5 text-xs text-zinc-600 dark:bg-zinc-800 dark:text-zinc-300">
              {tag}
            </span>
          ))}
        </div>
      )
    }
  </div>
</a>
