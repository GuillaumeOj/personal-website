---
import { type Locale, SITE } from '../config';
import { t } from '../i18n/ui';

/** "Or email me directly" line with a visible mailto link to the public inbox. */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<p class="text-sm text-muted">
  {t(locale, 'home.contact.emailLabel')}{' '}
  <a href={`mailto:${SITE.email}`} class="text-accent-ink no-underline hover:underline">
    {SITE.email}
  </a>
</p>
