---
import PostList from '../../components/PostList.astro';
import { SITE } from '../../config';
import { t } from '../../i18n/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPostsForLocale } from '../../lib/posts';

const locale = 'fr' as const;
const posts = await getPostsForLocale(locale);
---

<BaseLayout
  locale={locale}
  title={`${t(locale, 'blog.title')} — ${SITE.name}`}
  description={t(locale, 'blog.subtitle')}
  container="full"
>
  <div class="mx-auto max-w-6xl px-6 py-12 sm:py-16">
    <section class="max-w-2xl space-y-3">
      <h1 class="page-title">{t(locale, 'blog.title')}</h1>
      <p class="text-lg text-muted">
        {t(locale, 'blog.subtitle')}
      </p>
    </section>

    <div class="mt-10">
      <PostList posts={posts} locale={locale} />
    </div>
  </div>
</BaseLayout>
