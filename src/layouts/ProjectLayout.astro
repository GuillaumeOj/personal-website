---
import ProjectImage from '../components/ProjectImage.astro';
import type { Locale } from '../config';
import { localizedPath, t } from '../i18n/ui';
import { localizedName, type Project, resolveImage } from '../lib/projects';
import BaseLayout from './BaseLayout.astro';

interface Props {
  locale: Locale;
  project: Project;
}

const { locale, project } = Astro.props;
const { description, aim } = project.content[locale];
const contextLabel = t(locale, `projects.context.${project.context}`);
const screenshot = resolveImage(project.banner ?? project.cover, locale);
const name = localizedName(project, locale);
---

<BaseLayout locale={locale} title={name} description={description}>
  <article class="space-y-8">
    <a
      href={localizedPath(locale, '/projects')}
      class="inline-block text-sm text-zinc-600 dark:text-zinc-400"
    >
      {t(locale, 'projects.backToList')}
    </a>

    <div class="flex justify-center overflow-hidden rounded-lg border border-zinc-200 bg-zinc-50 dark:border-zinc-800 dark:bg-zinc-900">
      <ProjectImage
        variants={screenshot}
        priority
        class="h-auto max-h-[80vh] w-auto max-w-full object-contain"
      />
    </div>

    <header class="space-y-3">
      <span class="text-sm text-zinc-500 dark:text-zinc-400">{contextLabel}</span>
      <h1 class="text-3xl font-bold tracking-tight text-zinc-900 sm:text-4xl dark:text-zinc-100">
        {name}
      </h1>
      <p class="text-lg text-zinc-600 dark:text-zinc-400">{description}</p>
      <div class="flex flex-wrap gap-3 pt-1">
        {
          project.url && (
            <a
              href={project.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center rounded-md bg-zinc-900 px-4 py-2 text-sm font-medium text-white no-underline transition-colors hover:bg-zinc-700 dark:bg-zinc-100 dark:text-zinc-900 dark:hover:bg-zinc-300"
            >
              {t(locale, 'projects.visit')}
            </a>
          )
        }
        {
          project.repoUrl && (
            <a
              href={project.repoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center rounded-md border border-zinc-300 px-4 py-2 text-sm font-medium text-zinc-700 no-underline transition-colors hover:bg-zinc-100 dark:border-zinc-700 dark:text-zinc-300 dark:hover:bg-zinc-900"
            >
              {t(locale, 'projects.viewSource')}
            </a>
          )
        }
      </div>
    </header>

    <dl class="space-y-6 border-t border-zinc-200 pt-6 dark:border-zinc-800">
      <div class="space-y-1">
        <dt class="text-sm font-semibold tracking-tight text-zinc-900 dark:text-zinc-100">
          {t(locale, 'projects.aim')}
        </dt>
        <dd class="text-zinc-600 dark:text-zinc-400">{aim}</dd>
      </div>
      <div class="space-y-2">
        <dt class="text-sm font-semibold tracking-tight text-zinc-900 dark:text-zinc-100">
          {t(locale, 'projects.stack')}
        </dt>
        <dd class="flex flex-wrap gap-1.5">
          {
            project.stack.map((tag) => (
              <span class="rounded bg-zinc-100 px-2 py-0.5 text-xs text-zinc-600 dark:bg-zinc-800 dark:text-zinc-300">
                {tag}
              </span>
            ))
          }
        </dd>
      </div>
    </dl>
  </article>
</BaseLayout>
