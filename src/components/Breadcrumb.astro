---
import type { Locale } from '../config';
import { t } from '../i18n/ui';
import type { Crumb } from '../lib/schema';

/**
 * A visible breadcrumb trail mirroring the page's `BreadcrumbList` JSON-LD.
 * Root first, current page last: the last crumb is marked `aria-current="page"`
 * and rendered as plain text (not a link), the rest as muted links.
 */
interface Props {
  locale: Locale;
  /** The same crumbs as the page's `BreadcrumbList` (see `navTrail`). */
  items: Crumb[];
  class?: string;
}

const { locale, items, class: className } = Astro.props;
---

<nav aria-label={t(locale, 'nav.breadcrumb')} class:list={['text-sm text-muted', className]}>
  <ol class="flex flex-wrap items-center gap-1.5">
    {
      items.map((item, i) => {
        const isLast = i === items.length - 1;
        return (
          <li class="flex items-center gap-1.5">
            {i > 0 && (
              <span aria-hidden="true" class="select-none text-line">
                /
              </span>
            )}
            {isLast ? (
              <span aria-current="page" class="text-ink">
                {item.name}
              </span>
            ) : (
              <a href={item.url} class="no-underline hover:text-ink-strong">
                {item.name}
              </a>
            )}
          </li>
        );
      })
    }
  </ol>
</nav>
