---
import type { Locale } from '../config';
import { t } from '../i18n/ui';
import Dropdown from './Dropdown.astro';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const modes = [
  { mode: 'system', icon: 'monitor', label: t(locale, 'theme.system') },
  { mode: 'light', icon: 'sun', label: t(locale, 'theme.light') },
  { mode: 'dark', icon: 'moon', label: t(locale, 'theme.dark') },
] as const;
---

<Dropdown label={t(locale, 'theme.toggle')}>
  <Icon slot="trigger" name="sun" data-theme-icon="light" />
  <Icon slot="trigger" name="moon" data-theme-icon="dark" class="hidden" />
  <Icon slot="trigger" name="monitor" data-theme-icon="system" class="hidden" />
  <Icon slot="trigger" name="chevron-down" size={14} />

  {
    modes.map((m) => (
      <button
        type="button"
        role="menuitem"
        data-theme-option={m.mode}
        class="menu-item"
      >
        <Icon name={m.icon} size={16} />
        <span class="flex-1">{m.label}</span>
        <Icon name="check" size={16} data-theme-check class="hidden text-accent-ink" />
      </button>
    ))
  }
</Dropdown>

<script>
  type ThemeMode = 'light' | 'dark' | 'system';
  const STORAGE_KEY = 'theme';

  const isThemeMode = (value: string | null): value is ThemeMode =>
    value === 'light' || value === 'dark' || value === 'system';

  const getStoredMode = (): ThemeMode => {
    const value = localStorage.getItem(STORAGE_KEY);
    return isThemeMode(value) ? value : 'system';
  };

  const resolveAppliedTheme = (mode: ThemeMode): 'light' | 'dark' => {
    if (mode !== 'system') return mode;
    return window.matchMedia('(prefers-color-scheme: dark)').matches
      ? 'dark'
      : 'light';
  };

  const applyMode = (mode: ThemeMode): void => {
    document.documentElement.classList.toggle(
      'dark',
      resolveAppliedTheme(mode) === 'dark',
    );
    document.documentElement.dataset.themeMode = mode;
    document
      .querySelectorAll<HTMLElement>('[data-theme-icon]')
      .forEach((icon) => {
        icon.classList.toggle('hidden', icon.dataset.themeIcon !== mode);
      });
    document
      .querySelectorAll<HTMLElement>('[data-theme-option]')
      .forEach((btn) => {
        const active = btn.dataset.themeOption === mode;
        btn.setAttribute('aria-current', active ? 'true' : 'false');
        btn
          .querySelector<HTMLElement>('[data-theme-check]')
          ?.classList.toggle('hidden', !active);
      });
  };

  const setMode = (mode: ThemeMode): void => {
    localStorage.setItem(STORAGE_KEY, mode);
    applyMode(mode);
  };

  const init = (): void => {
    applyMode(getStoredMode());
    document
      .querySelectorAll<HTMLButtonElement>('[data-theme-option]')
      .forEach((btn) => {
        btn.addEventListener('click', () => {
          const mode = btn.dataset.themeOption ?? null;
          if (isThemeMode(mode)) setMode(mode);
        });
      });

    window
      .matchMedia('(prefers-color-scheme: dark)')
      .addEventListener('change', () => {
        if (getStoredMode() === 'system') applyMode('system');
      });
  };

  init();
  document.addEventListener('astro:after-swap', init);
</script>
