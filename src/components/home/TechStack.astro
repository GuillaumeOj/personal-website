---
import type { Locale } from '../../config';
import { tech } from '../../lib/home';
import Section from './Section.astro';
import SectionHeader from './SectionHeader.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<Section id="tech" class="bg-surface-sunken">
  <SectionHeader locale={locale} eyebrow={tech.eyebrow} title={tech.title} />

  <dl class="reveal mt-10 grid gap-x-8 gap-y-8 sm:grid-cols-2 lg:grid-cols-4">
    {
      tech.groups.map((group) => (
        <div>
          <dt class="font-mono text-xs uppercase tracking-[0.16em] text-muted">
            {group.label[locale]}
          </dt>
          <dd class="mt-3 flex flex-wrap gap-2">
            {group.items.map((item) => (
              <span class="rounded-lg border border-line bg-surface px-3 py-1.5 font-mono text-sm text-ink">
                {item}
              </span>
            ))}
          </dd>
        </div>
      ))
    }
  </dl>
</Section>
