---
import type { Locale } from '../../config';
import { services, whatIDo } from '../../lib/home';
import Section from './Section.astro';
import SectionHeader from './SectionHeader.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<Section id="services">
  <SectionHeader
    locale={locale}
    eyebrow={whatIDo.eyebrow}
    title={whatIDo.title}
    lead={whatIDo.lead}
  />

  <ol class="reveal mt-10 grid list-none gap-4 p-0 sm:grid-cols-3">
    {
      whatIDo.pillars.map((pillar, i) => (
        <li class="rounded-2xl border border-line bg-surface p-6">
          <div class="flex items-baseline gap-3">
            <span class="font-mono text-sm text-accent-ink">
              0{i + 1}
            </span>
            <h3 class="font-display text-lg font-semibold text-ink-strong">
              {pillar.label[locale]}
            </h3>
          </div>
          <p class="mt-3 text-sm leading-relaxed text-muted">
            {pillar.desc[locale]}
          </p>
        </li>
      ))
    }
  </ol>

  <h3 class="reveal subheading mt-14">
    {services.title[locale]}
  </h3>

  <div class="reveal mt-6 grid gap-6 md:grid-cols-2">
    {
      services.items.map((service) => (
        <div class="flex flex-col rounded-2xl border border-line bg-surface p-7">
          <h4 class="font-display text-lg font-semibold text-ink-strong">
            {service.label[locale]}
          </h4>
          <p class="mt-2 text-muted">{service.desc[locale]}</p>
          <ul class="mt-6 space-y-3 border-t border-line pt-6 text-sm text-ink list-none p-0">
            {service.features.map((feature) => (
              <li class="flex items-start gap-3">
                <svg
                  viewBox="0 0 20 20"
                  fill="none"
                  class="mt-0.5 h-4 w-4 shrink-0 text-accent"
                  aria-hidden="true"
                >
                  <path
                    d="m5 10.5 3.2 3.2L15 6.5"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
                <span>{feature[locale]}</span>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</Section>
