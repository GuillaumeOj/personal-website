---
import AboutTeaser from '../../components/home/AboutTeaser.astro';
import Contact from '../../components/home/Contact.astro';
import FeaturedProjects from '../../components/home/FeaturedProjects.astro';
import Hero from '../../components/home/Hero.astro';
import HowIWork from '../../components/home/HowIWork.astro';
import WhatIDo from '../../components/home/WhatIDo.astro';
import { t } from '../../i18n/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';

const locale = 'en' as const;
---

<BaseLayout
  locale={locale}
  title={t(locale, 'meta.homeTitle')}
  description="Freelance full-stack developer in Lyon: web and mobile apps, from frontend to deployment. Python/Django, React Native, Next.js, PostgreSQL."
  container="full"
  snap
  hreflang
>
  <Hero locale={locale} />
  <WhatIDo locale={locale} />
  <HowIWork locale={locale} />
  <FeaturedProjects locale={locale} />
  <Contact locale={locale} />
  <AboutTeaser locale={locale} />
</BaseLayout>
