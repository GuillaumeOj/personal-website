---
import ContactContent from '@/components/contact/ContactContent.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { contactJsonLd, contactModes } from '@/lib/contact-page';

const locale = 'fr' as const;
const mode = 'general' as const;
const { meta } = contactModes[mode];
---

<BaseLayout
  locale={locale}
  title={meta.title[locale]}
  description={meta.description[locale]}
  jsonLd={contactJsonLd(locale, mode)}
  container="full"
>
  <ContactContent locale={locale} mode={mode} />
</BaseLayout>
