---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../config';
import { formatDate, localizedPath, t } from '../i18n/ui';

interface Props {
  posts: CollectionEntry<'blog'>[];
  locale: Locale;
}

const { posts, locale } = Astro.props;
---

{
  posts.length === 0 ? (
    <p class="text-zinc-500">{t(locale, 'blog.empty')}</p>
  ) : (
    <ul class="space-y-8 list-none p-0">
      {posts.map((post) => {
        const slug = post.id.replace(/^[a-z]{2}\//, '');
        const href = localizedPath(locale, `/blog/${slug}`);
        return (
          <li class="border-b border-zinc-100 pb-8 last:border-b-0 dark:border-zinc-900">
            <article>
              <h2 class="text-xl font-semibold tracking-tight">
                <a
                  href={href}
                  class="text-zinc-900 no-underline hover:underline dark:text-zinc-100"
                >
                  {post.data.title}
                </a>
              </h2>
              <p class="mt-1 text-sm text-zinc-500">
                <time datetime={post.data.pubDate.toISOString()}>
                  {formatDate(post.data.pubDate, locale)}
                </time>
              </p>
              <p class="mt-3 text-zinc-600 dark:text-zinc-400">
                {post.data.description}
              </p>
            </article>
          </li>
        );
      })}
    </ul>
  )
}
