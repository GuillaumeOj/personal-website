---
import type { Locale } from '../../config';
import { projectPath, quotePath, t } from '../../i18n/ui';
import {
  cost,
  faq,
  hero,
  included,
  mobile,
  projectFlow,
  servicesCrumbs,
  web,
} from '../../lib/services';
import Breadcrumb from '../Breadcrumb.astro';
import ContactCta from '../ContactCta.astro';
import Section from '../home/Section.astro';
import SectionHeader from '../home/SectionHeader.astro';
import Icon from '../Icon.astro';
import CheckList from '../lists/CheckList.astro';
import NumberedCards from '../lists/NumberedCards.astro';
import Timeline from '../lists/Timeline.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

// Visible trail (Home › Services), rendered inside the hero section (top-left,
// on the sunken background) rather than a separate strip above it. Mirrors the
// BreadcrumbList JSON-LD emitted by `servicesJsonLd`.
const crumbs = servicesCrumbs(locale);

/** The two proof-with-a-link blocks share the same offering shape. */
const offerings = [
  { id: 'mobile', data: mobile, sunken: false },
  { id: 'web', data: web, sunken: true },
];

// Every contact CTA here opens the quote-request form.
const quoteHref = quotePath(locale);

const linkClass =
  'font-display font-medium text-accent-ink no-underline hover:underline';
---

<section class="flex min-h-svh flex-col bg-surface-sunken px-6 pb-24 pt-8">
  <div class="mx-auto w-full max-w-6xl">
    <Breadcrumb locale={locale} items={crumbs} />
  </div>
  <div class="flex flex-1 items-center">
    <div class="mx-auto w-full max-w-6xl">
      <div class="reveal max-w-3xl space-y-7">
      <h1
        class="font-display text-4xl font-bold leading-[1.08] tracking-tight text-ink-strong sm:text-5xl"
      >
        {hero.title[locale]}
      </h1>
      <p class="text-lg leading-relaxed text-muted">{hero.subtitle[locale]}</p>
      <div class="flex flex-wrap gap-3 pt-1">
        <a href={quoteHref} class="btn btn-primary">{t(locale, 'cta.talk')}</a>
        <a href="#mobile" class="btn btn-secondary">
          {hero.anchorMobile[locale]}
          <Icon name="arrow-right" size={15} />
        </a>
        <a href="#web" class="btn btn-secondary">
          {hero.anchorWeb[locale]}
          <Icon name="arrow-right" size={15} />
        </a>
      </div>
      <p class="font-mono text-xs uppercase tracking-[0.14em] text-muted">
        {hero.reassurance[locale]}
      </p>
      <p class="border-t border-line pt-5 text-sm leading-relaxed text-muted">
          {hero.credibility[locale]}
        </p>
      </div>
    </div>
  </div>
</section>

{
  offerings.map(({ id, data, sunken }) => (
    <Section id={id} class={sunken ? 'bg-surface-sunken' : ''}>
      <SectionHeader locale={locale} title={data.title} lead={data.intro} />

      <div class="reveal mt-8 rounded-2xl border border-line bg-surface p-7">
        <p class="font-display font-semibold text-ink-strong">
          {data.leadIn[locale]}
        </p>
        <CheckList
          locale={locale}
          items={data.list}
          class="mt-6 border-t border-line pt-6"
        />
      </div>

      <p class="reveal mt-6 max-w-2xl leading-relaxed text-muted">
        {data.proof.map((run) =>
          run.t === 'link' ? (
            <a href={projectPath(locale, run.slug)} class={linkClass}>
              {run.v[locale]}
            </a>
          ) : (
            run.v[locale]
          ),
        )}
      </p>
    </Section>
  ))
}

<Section id="included">
  <SectionHeader locale={locale} title={included.title} lead={included.intro} />

  <NumberedCards locale={locale} items={included.items} />
</Section>

<Section id="process" class="bg-surface-sunken">
  <SectionHeader
    locale={locale}
    title={projectFlow.title}
    lead={projectFlow.intro}
  />

  <Timeline locale={locale} items={projectFlow.steps} />

  <p class="reveal mt-2 max-w-2xl leading-relaxed text-muted">
    {projectFlow.reassurance[locale]}
  </p>
</Section>

<Section id="cost">
  <SectionHeader locale={locale} title={cost.title} lead={cost.intro} />

  <CheckList locale={locale} items={cost.list} class="reveal mt-8" />

  <p class="reveal mt-6 max-w-2xl leading-relaxed text-muted">
    {cost.closing[locale]}
  </p>

  <p class="reveal mt-6">
    <a href={quoteHref} class="btn btn-secondary">
      {cost.cta[locale]}
      <Icon name="arrow-right" size={15} />
    </a>
  </p>
</Section>

<Section id="faq" class="bg-surface-sunken">
  <SectionHeader locale={locale} title={faq.title} />

  <div class="reveal mt-10 divide-y divide-line rounded-2xl border border-line bg-surface">
    {
      faq.items.map((item) => (
        <div class="p-6">
          <h3 class="font-display text-lg font-semibold text-ink-strong">
            {item.q[locale]}
          </h3>
          <p class="mt-2 leading-relaxed text-muted">{item.a[locale]}</p>
        </div>
      ))
    }
  </div>
</Section>

<ContactCta locale={locale} mode="quote" />
