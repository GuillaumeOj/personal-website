---
import type { Locale } from '../config';
import { otherLocale, t } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const target = otherLocale(locale);

const currentPath = Astro.url.pathname;
const stripped =
  locale === 'en' ? currentPath.replace(/^\/en(\/|$)/, '/') : currentPath;
const targetPath = target === 'fr' ? stripped : `/en${stripped === '/' ? '' : stripped}`;
const normalized = targetPath.endsWith('/') ? targetPath : `${targetPath}/`;
---

<a
  href={normalized}
  hreflang={target}
  data-lang-switcher
  aria-label={t(locale, 'lang.switch')}
  class="inline-flex h-9 items-center justify-center rounded-md border border-zinc-200 px-3 text-sm font-medium uppercase tracking-wide text-zinc-600 no-underline transition-colors hover:bg-zinc-100 hover:text-zinc-900 dark:border-zinc-800 dark:text-zinc-400 dark:hover:bg-zinc-900 dark:hover:text-zinc-100"
>
  {target}
</a>
