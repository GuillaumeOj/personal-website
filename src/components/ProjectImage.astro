---
import { Image } from 'astro:assets';
import type { ThemeVariants } from '../lib/projects';

interface Props {
  variants: ThemeVariants;
  alt?: string;
  class?: string;
  priority?: boolean;
  /** Candidate widths for the generated srcset (capped at the source width). */
  widths?: number[];
  /** `sizes` hint describing the rendered width across breakpoints. */
  sizes?: string;
  /**
   * WebP compression quality. Defaults below Astro's 80 — these covers are UI
   * screenshots shown small (cards) or as previews, where the extra bytes at
   * 80 aren't worth it (Lighthouse flagged the Fusily portrait for this).
   */
  quality?: number;
}

const {
  variants,
  alt = '',
  class: className = '',
  priority = false,
  widths = [400, 640, 960, 1280],
  sizes = '(min-width: 768px) 720px, 100vw',
  quality = 72,
} = Astro.props;
const { light, dark } = variants;
const single = light === dark;
// Only CSS knows which theme variant is visible, so a priority image is eager
// in both (a lazy variant is the visible one for half the visitors otherwise).
// `high` only for a single image: on a themed pair it would also boost the
// hidden one, which then competes with the visible LCP image for bandwidth.
const shared = {
  alt,
  widths,
  sizes,
  quality,
  loading: priority ? 'eager' : 'lazy',
  fetchpriority: priority && single ? 'high' : 'auto',
} as const;
const themed = single
  ? [{ src: light, class: className }]
    : [
        { src: light, class: `${className} block dark:hidden` },
        { src: dark, class: `${className} hidden dark:block` },
      ];
---

{themed.map((variant) => <Image {...shared} {...variant} />)}
