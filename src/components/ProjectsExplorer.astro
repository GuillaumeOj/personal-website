---
import type { Locale } from '../config';
import { t } from '../i18n/ui';
import {
  getAvailablePlatforms,
  type Project,
} from '../lib/projects';
import ProjectCard from './ProjectCard.astro';

interface Props {
  projects: Project[];
  locale: Locale;
}

const { projects, locale } = Astro.props;
const platforms = getAvailablePlatforms();
// `as const` narrows each entry to a literal so `projects.filter.${filter}`
// stays a valid translation key.
const filters = ['all', ...platforms] as const;
---

{
  projects.length === 0 ? (
    <p class="text-muted">{t(locale, 'projects.empty')}</p>
  ) : (
    <div data-projects-explorer>
      {platforms.length > 0 && (
        <div
          class="mb-8 flex flex-wrap gap-2"
          role="group"
          aria-label={t(locale, 'projects.filter.label')}
        >
          {filters.map((filter) => (
            <button
              type="button"
              data-filter={filter}
              aria-pressed={filter === 'all' ? 'true' : 'false'}
              class="rounded-full border border-line px-4 py-1.5 font-mono text-xs uppercase tracking-wide text-muted transition-colors hover:text-ink-strong aria-pressed:border-transparent aria-pressed:bg-btn-bg aria-pressed:text-accent-contrast"
            >
              {t(locale, `projects.filter.${filter}`)}
            </button>
          ))}
        </div>
      )}

      <div
        class="grid grid-cols-1 gap-6 sm:grid-cols-2"
        data-projects-grid
      >
        {projects.map((project, i) => (
          <ProjectCard project={project} locale={locale} priority={i === 0} />
        ))}
      </div>

      <p
        class="mt-6 hidden text-muted"
        data-projects-empty
        role="status"
        aria-live="polite"
      >
        {t(locale, 'projects.filter.none')}
      </p>
    </div>
  )
}

<script>
  const explorer = document.querySelector<HTMLElement>(
    '[data-projects-explorer]',
  );
  if (explorer) {
    const buttons =
      explorer.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const cards = explorer.querySelectorAll<HTMLElement>('[data-platform]');
    const emptyMsg = explorer.querySelector<HTMLElement>(
      '[data-projects-empty]',
    );

    const apply = (filter: string) => {
      let visible = 0;
      for (const card of cards) {
        const platforms = (card.dataset.platform ?? '').split(' ');
        const show = filter === 'all' || platforms.includes(filter);
        card.classList.toggle('hidden', !show);
        if (show) visible++;
      }
      for (const button of buttons) {
        button.setAttribute(
          'aria-pressed',
          button.dataset.filter === filter ? 'true' : 'false',
        );
      }
      emptyMsg?.classList.toggle('hidden', visible > 0);
    };

    for (const button of buttons) {
      button.addEventListener('click', () =>
        apply(button.dataset.filter ?? 'all'),
      );
    }
  }
</script>
