---
import ProjectsExplorer from '../../../components/ProjectsExplorer.astro';
import { SITE } from '../../../config';
import { t } from '../../../i18n/ui';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getProjects } from '../../../lib/projects';

const locale = 'en' as const;
const projects = getProjects();
---

<BaseLayout
  locale={locale}
  title={`${t(locale, 'projects.title')} — ${SITE.name}`}
  description={t(locale, 'projects.subtitle')}
  rawTitle
  container="full"
>
  <div class="mx-auto max-w-6xl px-6 py-12 sm:py-16">
    <section class="max-w-2xl space-y-3">
      <h1 class="page-title">{t(locale, 'projects.title')}</h1>
      <p class="text-lg text-muted">{t(locale, 'projects.subtitle')}</p>
    </section>

    <div class="mt-10">
      <ProjectsExplorer projects={projects} locale={locale} />
    </div>
  </div>
</BaseLayout>
