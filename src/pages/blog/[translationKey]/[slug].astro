---
import type { CollectionEntry } from 'astro:content';
import BlogPostLayout from '../../../layouts/BlogPostLayout.astro';
import { renderNotionPage } from '../../../lib/notion';
import { getPostsForLocale } from '../../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPostsForLocale('fr');
  return posts.map((post) => ({
    params: {
      translationKey: post.data.translationKey,
      slug: post.data.slug,
    },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const html = await renderNotionPage(post.id);
---

<BlogPostLayout locale="fr" post={post}>
  <Fragment set:html={html} />
</BlogPostLayout>
