---
import { SITE, type Locale } from '../config';
import { localizedPath, navItems } from '../i18n/ui';
import LangSwitcher from './LangSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const home = localizedPath(locale, '/');
const links = navItems(locale);
---

<header
  class="sticky top-0 z-20 border-b border-line bg-paper/80 backdrop-blur"
>
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-6 py-4">
    <a
      href={home}
      class="font-display text-base font-semibold tracking-tight text-ink-strong no-underline"
    >
      {SITE.name}
    </a>
    <nav class="flex items-center gap-1 text-sm">
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={[
              'rounded-md px-2.5 py-1 text-muted no-underline transition-colors hover:bg-surface-sunken hover:text-ink-strong',
              link.compact ? 'inline-block' : 'hidden sm:inline-block',
            ]}
          >
            {link.label}
          </a>
        ))
      }
      <span class="mx-1 h-5 w-px bg-line" aria-hidden="true"></span>
      <LangSwitcher locale={locale} />
      <ThemeToggle locale={locale} />
    </nav>
  </div>
</header>
