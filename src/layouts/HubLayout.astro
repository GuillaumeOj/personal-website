---
import Breadcrumb from '@/components/Breadcrumb.astro';
import type { Locale } from '@/config';
import { localizedUrl, type TranslationKey } from '@/i18n/ui';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { collectionPageJsonLd, navTrail } from '@/lib/schema';

// A section index (blog, projects): Home › Section breadcrumb, a
// CollectionPage JSON-LD, the page heading and the list in the slot.
interface Props {
  locale: Locale;
  /** Unlocalized section path, e.g. '/blog'. */
  path: string;
  /** Nav label of the section, its breadcrumb name. */
  navKey: TranslationKey;
  metaTitle: string;
  metaDescription: string;
  heading: string;
  subtitle: string;
}

const { locale, path, navKey, metaTitle, metaDescription, heading, subtitle } =
  Astro.props;

const canonical = localizedUrl(locale, path);
const crumbs = navTrail(locale, [navKey, path]);
const jsonLd = collectionPageJsonLd(locale, {
  url: canonical,
  name: metaTitle,
  description: metaDescription,
  breadcrumbs: crumbs,
});
---

<BaseLayout
  locale={locale}
  title={metaTitle}
  description={metaDescription}
  jsonLd={jsonLd}
  container="full"
  hreflang
>
  <div class="mx-auto max-w-6xl px-6 pt-8">
    <Breadcrumb locale={locale} items={crumbs} />
  </div>
  <div class="mx-auto max-w-6xl px-6 py-12 sm:py-16">
    <section class="max-w-2xl space-y-3">
      <h1 class="page-title">{heading}</h1>
      <p class="text-lg text-muted">{subtitle}</p>
    </section>

    <slot />
  </div>
</BaseLayout>
