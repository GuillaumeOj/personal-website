---
import type { Locale } from '../config';
import { projectPath, t } from '../i18n/ui';
import { localizedName, type Project, resolveImage } from '../lib/projects';
import ProjectImage from './ProjectImage.astro';

interface Props {
  project: Project;
  locale: Locale;
  priority?: boolean;
  /** Heading level of the card title: 3 under a section heading (home). */
  headingLevel?: 2 | 3;
}

const { project, locale, priority = false, headingLevel = 2 } = Astro.props;
const Heading = `h${headingLevel}` as const;
const href = projectPath(locale, project.slug);
const { description } = project.content[locale];
const contextLabel = t(locale, `projects.context.${project.context}`);
const cover = resolveImage(project.cover, locale);
const name = localizedName(project, locale);
const result = project.result?.[locale];
const resultLabel = t(locale, 'projects.result');
const tags = project.stack.slice(0, 4);
---

<a
  href={href}
  aria-label={name}
  data-platform={project.platform.join(' ')}
  class="group card-link"
>
  <div class="relative aspect-[16/10] w-full overflow-hidden bg-surface-sunken">
    <ProjectImage
      variants={cover}
      alt={project.imageAlt[locale]}
      priority={priority}
      sizes="(min-width: 1024px) 520px, (min-width: 640px) 50vw, 100vw"
      class="h-full w-full object-cover object-top transition-transform duration-500 ease-out group-hover:scale-[1.04]"
    />
    <div class="absolute left-3 top-3 flex flex-wrap gap-1.5">
      {
        project.platform.map((platform) => (
          <span class="rounded-full bg-paper/90 px-2.5 py-1 font-mono text-[0.65rem] font-medium uppercase tracking-wide text-accent-ink backdrop-blur">
            {t(locale, `projects.filter.${platform}`)}
          </span>
        ))
      }
    </div>
  </div>
  <div class="flex flex-1 flex-col gap-2 p-5">
    <div class="flex items-center justify-between gap-2">
      <Heading class="font-display text-lg font-semibold tracking-tight text-ink-strong">
        {name}
      </Heading>
      <span class="shrink-0 text-xs text-muted">{contextLabel}</span>
    </div>
    <p class="line-clamp-3 text-sm leading-relaxed text-muted">{description}</p>
    {
      result && (
        <p class="text-sm leading-relaxed text-ink">
          <span class="font-mono text-xs uppercase tracking-wide text-accent-ink">
            {resultLabel} ·{' '}
          </span>
          {result}
        </p>
      )
    }
    {
      tags.length > 0 && (
        <div class="mt-auto flex flex-wrap gap-1.5 pt-3">
          {tags.map((tag) => (
            <span class="rounded-md bg-surface-sunken px-2 py-0.5 font-mono text-xs text-muted">
              {tag}
            </span>
          ))}
        </div>
      )
    }
  </div>
</a>
