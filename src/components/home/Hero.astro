---
import type { Locale } from '../../config';
import { hero } from '../../lib/home';
import { localizedPath } from '../../i18n/ui';
import Icon from '../Icon.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const projectsHref = localizedPath(locale, '/projects');

const lead = hero.closingLead[locale];
const phrases = hero.closingRotating[locale];
// Index 0 is the safe default: server-rendered so the sentence is complete
// with JS off, and the first phrase every visitor reads.
const defaultSentence = `${lead} ${phrases[0]}`;
---

<section class="relative flex items-center px-6 py-24">
  <div class="mx-auto w-full max-w-6xl">
    <div class="reveal flex max-w-2xl flex-col gap-7">
      <p class="eyebrow">{hero.eyebrow[locale]}</p>
      <h1
        class="font-display text-3xl font-semibold leading-[1.22] tracking-tight text-ink-strong sm:text-[2.125rem]"
      >
        {hero.title[locale]}
      </h1>

      <p class="hero-closing">
        {/* Assistive tech reads one clean, complete sentence… */}
        <span class="sr-only">{defaultSentence}</span>
        {/* …while the animated churn is hidden from the accessibility tree. */}
        <span aria-hidden="true">
          {lead}{' '}<span class="hero-rotate"
            ><span
              class="hero-rotate__word"
              data-hero-rotate
              data-phrases={JSON.stringify(phrases)}>{phrases[0]}</span
            ><span class="hero-rotate__caret"></span></span
          >
        </span>
      </p>

      <div class="flex flex-wrap gap-3 pt-1">
        <a href="#contact" class="btn btn-primary">{hero.ctaPrimary[locale]}</a>
        <a href={projectsHref} class="btn btn-secondary">
          {hero.ctaSecondary[locale]}
          <Icon name="arrow-right" size={15} />
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-closing {
    font-size: 1.3125rem; /* ~21px on mobile */
    font-weight: 400;
    line-height: 1.35;
    color: var(--ink);
    /* Reserve the line height so word swaps never shift the CTAs (CLS ~0).
       The closing line stays on a single line at desktop widths; on narrow
       screens the longest phrase may wrap, so two lines are reserved there. */
    min-height: 2.7em;
  }

  @media (min-width: 640px) {
    .hero-closing {
      font-size: 1.625rem; /* ~26px on desktop */
      min-height: 1.35em; /* single line — no phrase wraps at this width */
    }
  }

  /* Accent highlight pill around the rotating word. `box-decoration-break:
     clone` keeps the padding/radius intact if the word wraps on mobile, so it
     never causes horizontal overflow. Colours are token-driven and legible in
     both light and dark mode. */
  .hero-rotate {
    display: inline;
    padding: 1px 10px;
    border-radius: 0.375rem;
    color: var(--accent-ink);
    background: color-mix(in srgb, var(--accent) 14%, transparent);
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }

  .hero-rotate__word {
    font-weight: 500;
  }

  /* Blinking text caret — a 2px accent bar pinned to the end of the word, so it
     stays attached to the last visible character as the text types/deletes. */
  .hero-rotate__caret {
    display: inline-block;
    width: 0;
    height: 1em;
    margin-left: 1px;
    vertical-align: text-bottom;
    border-right: 2px solid var(--accent);
    animation: hero-caret-blink 1s steps(1) infinite;
  }

  @keyframes hero-caret-blink {
    0%,
    50% {
      opacity: 1;
    }
    50.01%,
    100% {
      opacity: 0;
    }
  }

  /* Reduced motion: no typing (the script bails) and no blinking caret — the
     static default phrase stands on its own. */
  @media (prefers-reduced-motion: reduce) {
    .hero-rotate__caret {
      display: none;
    }
  }
</style>

<script is:inline>
  // Kinetic closing line: types the current phrase in, holds, deletes, pauses,
  // then swaps to the next — forever, calmly. Enhancement only: the default
  // phrase (index 0) is already server-rendered, so JS-off and reduced-motion
  // visitors read a complete sentence. Timings reproduce the reference feel.
  (() => {
    if (typeof document === 'undefined') return;
    const el = document.querySelector('[data-hero-rotate]');
    if (!el) return;
    if (
      typeof matchMedia === 'function' &&
      matchMedia('(prefers-reduced-motion: reduce)').matches
    ) {
      return; // leave the static default phrase in place
    }

    let phrases;
    try {
      phrases = JSON.parse(el.dataset.phrases || '[]');
    } catch {
      return;
    }
    if (!Array.isArray(phrases) || phrases.length < 2) return;

    const TYPE = 42; // ms per character typed
    const HOLD = 1900; // ms the full phrase stays visible
    const DEL = 26; // ms per character deleted (faster than typing)
    const PAUSE = 220; // ms of stillness before the next phrase types in

    const wait = (ms) => new Promise((resolve) => setTimeout(resolve, ms));
    let index = 0; // index 0 is already rendered — start by holding it

    const typeIn = async (word) => {
      for (let i = 1; i <= word.length; i++) {
        el.textContent = word.slice(0, i);
        await wait(TYPE);
      }
    };
    const deleteOut = async (word) => {
      for (let i = word.length - 1; i >= 0; i--) {
        el.textContent = word.slice(0, i);
        await wait(DEL);
      }
    };

    (async () => {
      while (true) {
        await wait(HOLD);
        await deleteOut(phrases[index]);
        await wait(PAUSE);
        index = (index + 1) % phrases.length;
        await typeIn(phrases[index]);
      }
    })();
  })();
</script>
